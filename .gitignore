# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev.log
preview.log
preview.err.log


# environment variables
.env
.env.production

# FAQ live-editée via /admin/faq.php : état serveur, jamais commité.
# Le contenu par défaut/de secours reste dans public/data/faq.default.json.
public/data/faq.json

# Questions envoyées par les visiteurs depuis /faq (public/ask-question.php) : état
# serveur, jamais commité.
public/data/questions.json

# Abonnés newsletter écrits en live par public/api/subscribe.php et
# désinscriptions par public/api/unsubscribe.php : état serveur, jamais commité.
public/data/subscribers.json

# Compteurs de limitation de débit (public/lib/rate-limit.php), écrits en live
# par contact.php et api/subscribe.php : état serveur, jamais commité.
public/data/rate-limits.json

# Config générée au déploiement à partir des secrets GitHub Actions (voir
# scripts/write-admin-config.mjs et scripts/write-api-config.mjs) : n'existe
# jamais dans le repo, seulement dans dist/ après build en CI.
public/admin/config.php
public/api/config.php

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Equipements edites depuis /admin/equipements.php en production.
# Le contenu par defaut reste dans public/data/equipements.default.json.
public/data/equipements.json

# Photos d'equipements televersees depuis l'admin.
public/uploads/equipements/*
!public/uploads/equipements/.gitkeep

# Réglages du module commercial édités depuis /admin/parametres.php : état
# serveur, jamais commité. Les valeurs par défaut restent dans
# public/data/settings.default.json.
public/data/settings.json

# Base SQLite du module commercial et ses fichiers annexes (WAL, index partagé).
# Contiennent des données clients : jamais dans le dépôt.
public/data/private/*.sqlite
public/data/private/*.sqlite-wal
public/data/private/*.sqlite-shm
