---
/**
 * Mon compte (docs/SPEC-module-commercial.md §6.1).
 *
 * Quatre états, un seul visible à la fois : connexion, inscription, choix d'un
 * nouveau mot de passe (quand on arrive depuis le lien reçu par email), et
 * l'espace client une fois connecté.
 *
 * Tout le contenu est inerte dans le HTML statique : c'est le script qui décide
 * quoi montrer, après avoir demandé au serveur si une session est ouverte. Les
 * données affichées ne viennent jamais du navigateur.
 */

import PageCommerce from "../components/PageCommerce.astro";
---

<PageCommerce title="Mon compte" description="Vos coordonnées, vos adresses et vos commandes.">
	<div id="compte-zone" class="mt-8 max-w-[46rem]">
		<p class="t-petit text-brun-400">Chargement…</p>
	</div>
</PageCommerce>

<script>
	import { jetonCsrf, formaterCents } from "../scripts/panier";

	const zone = document.getElementById("compte-zone");

	/** Jeton courant. Renouvelé par le serveur à chaque connexion ou déconnexion. */
	let jeton: string | null = null;

	type Client = { id: number; email: string; prenom: string; nom: string };
	type Fournisseur = { id: string; nom: string };
	type Identite = { fournisseur: string; email: string };

	/**
	 * Messages de retour d'une connexion Google ou Facebook.
	 *
	 * Le motif arrive en clair dans l'URL (`?oauth=…`) parce que le fournisseur
	 * nous renvoie par une redirection : il n'y a pas de réponse JSON à lire.
	 * Rien de sensible n'y transite, seulement un code d'issue.
	 */
	const MESSAGES_OAUTH: Record<string, string> = {
		bienvenue: "Bienvenue ! Votre compte est créé.",
		connecte: "",
		lie: "Compte rattaché.",
		"deja-lie": "Ce compte est déjà rattaché à un autre client.",
		"compte-existant":
			"Un compte existe déjà avec cette adresse email. Connectez-vous avec votre mot de passe, " +
			"puis rattachez ce service depuis votre espace client.",
		"sans-email":
			"Ce service ne nous a communiqué aucune adresse email. Créez un compte avec une adresse : " +
			"nous devons pouvoir vous joindre au sujet d'une commande.",
		"compte-ferme": "Ce compte a été supprimé.",
		refus: "Connexion annulée.",
		etat: "La connexion a expiré. Réessayez.",
		echange: "Connexion impossible pour le moment.",
		profil: "Connexion impossible pour le moment.",
		indisponible: "Ce mode de connexion n'est pas disponible.",
	};

	/** Boutons « Continuer avec … », pour les fournisseurs réellement configurés. */
	function boutonsSociaux(fournisseurs: Fournisseur[], retour: string): HTMLElement | null {
		if (fournisseurs.length === 0) return null;

		const bloc = el("div", "mt-5 grid gap-2");
		fournisseurs.forEach((f) => {
			const lien = el(
				"a",
				"inline-flex items-center justify-center gap-2 rounded-full border border-ardoise/40 px-5 py-2.5 font-semibold text-brun-700 transition-colors hover:border-rouille-400 hover:text-rouille-500",
				`Continuer avec ${f.nom}`,
			);
			lien.href = `/api/oauth-demarrer.php?fournisseur=${encodeURIComponent(f.id)}&retour=${encodeURIComponent(retour)}`;
			bloc.append(lien);
		});

		const note = el(
			"p",
			"t-petit mt-1 text-brun-400",
			"Nous ne recevons que votre nom et votre adresse email, et rien n'est publié à votre place.",
		);
		bloc.append(note);

		return bloc;
	}
	type Adresse = {
		id: number;
		libelle: string;
		ligne1: string;
		ligne2: string;
		code_postal: string;
		ville: string;
		pays: string;
		telephone: string;
	};

	/** Appel JSON authentifié par le jeton CSRF courant. */
	async function envoyer(url: string, methode: string, corps?: unknown): Promise<any> {
		const entetes: Record<string, string> = { Accept: "application/json" };
		if (corps !== undefined) entetes["Content-Type"] = "application/json";
		if (jeton) entetes["X-CSRF-Token"] = jeton;

		const reponse = await fetch(url, {
			method: methode,
			cache: "no-store",
			credentials: "same-origin",
			headers: entetes,
			body: corps === undefined ? undefined : JSON.stringify(corps),
		});

		const donnees = await reponse.json().catch(() => ({}));
		// Le serveur renvoie un nouveau jeton chaque fois que la session change
		// d'identité : le suivre évite un refus au coup d'après.
		if (typeof donnees.csrf === "string") jeton = donnees.csrf;

		return { ok: reponse.ok, statut: reponse.status, donnees };
	}

	// ── Fabriques d'éléments ─────────────────────────────────────────────

	function el<K extends keyof HTMLElementTagNameMap>(
		balise: K,
		classe = "",
		texte = "",
	): HTMLElementTagNameMap[K] {
		const noeud = document.createElement(balise);
		if (classe) noeud.className = classe;
		if (texte) noeud.textContent = texte;
		return noeud;
	}

	function carte(titre: string): HTMLElement {
		const section = el("section", "mb-6 rounded-2xl border border-ardoise/30 bg-ecru-50 p-6");
		section.append(el("h2", "t-sous font-display font-semibold text-brun-700", titre));
		return section;
	}

	function champ(nom: string, intitule: string, type = "text", valeur = ""): HTMLLabelElement {
		const label = el("label", "mt-4 block");
		label.append(el("span", "t-petit font-medium text-brun-600", intitule));
		const input = el("input", "mt-1 w-full rounded-xl border border-ardoise/40 bg-white px-3 py-2 text-brun-700");
		input.type = type;
		input.name = nom;
		input.value = valeur;
		if (type === "password") input.autocomplete = nom === "motdepasse" ? "current-password" : "new-password";
		if (type === "email") input.autocomplete = "email";
		label.append(input);
		return label;
	}

	function boutonPrincipal(texte: string): HTMLButtonElement {
		const bouton = el("button", "mt-5 inline-flex items-center gap-2 rounded-full bg-rouille-500 px-5 py-2.5 font-semibold text-ecru-50 transition-colors hover:bg-rouille-400 disabled:opacity-50", texte);
		bouton.type = "submit";
		return bouton;
	}

	function lienBouton(texte: string): HTMLButtonElement {
		const bouton = el("button", "t-petit text-brun-500 underline transition-colors hover:text-rouille-500", texte);
		bouton.type = "button";
		return bouton;
	}

	function messagerie(): { noeud: HTMLElement; dire: (texte: string, erreur?: boolean) => void } {
		const noeud = el("p", "t-petit mt-4");
		noeud.setAttribute("role", "status");
		noeud.hidden = true;
		return {
			noeud,
			dire(texte: string, erreur = false) {
				noeud.textContent = texte;
				noeud.className = `t-petit mt-4 ${erreur ? "text-rouille-500" : "text-brun-500"}`;
				noeud.hidden = texte === "";
			},
		};
	}

	/** Valeur d'un champ du formulaire, toujours sous forme de chaîne. */
	function valeur(formulaire: HTMLFormElement, nom: string): string {
		const donnees = new FormData(formulaire).get(nom);
		return typeof donnees === "string" ? donnees : "";
	}

	/**
	 * Enveloppe commune aux fenêtres de la page : un <dialog> natif, dont Échap,
	 * le piège à focus et le voile sont gérés par le navigateur. Créée à la
	 * demande, retirée du document à la fermeture pour ne rien laisser derrière.
	 */
	function fenetre(libelleTitre: string): { boite: HTMLDialogElement; titre: HTMLElement } {
		const boite = el(
			"dialog",
			"m-auto w-[min(34rem,calc(100%-2rem))] rounded-2xl bg-ecru-50 p-0 text-brun-700 shadow-2xl backdrop:bg-brun-700/50",
		);
		const idTitre = `titre-fenetre-${Math.random().toString(36).slice(2, 8)}`;
		boite.setAttribute("aria-labelledby", idTitre);

		const titre = el("h2", "t-sous font-display font-semibold text-brun-700", libelleTitre);
		titre.id = idTitre;

		// Clic sur le voile : fermeture, comme les autres fenêtres du site.
		boite.addEventListener("click", (evenement) => {
			if (evenement.target === boite) boite.close();
		});

		// Retrait du document une fois fermée. Deux écouteurs plutôt qu'un :
		// l'événement `close` est celui qui fait foi, mais il ne se déclenche pas
		// dans tous les moteurs — vérifié le 29/09/2026 sur un Chromium embarqué
		// où seul `toggle` était émis, laissant une fenêtre morte dans le DOM à
		// chaque ouverture. `toggle` sert donc de filet, d'où le garde sur
		// `open` : il est aussi émis à l'ouverture.
		const retirer = () => {
			if (!boite.open) boite.remove();
		};
		boite.addEventListener("close", retirer);
		boite.addEventListener("toggle", retirer);

		return { boite, titre };
	}

	function ouvrir(boite: HTMLDialogElement, corps: HTMLElement): void {
		boite.append(corps);
		document.body.append(boite);
		boite.showModal();
	}

	/**
	 * Fenêtre d'adresse : ajout quand `adresse` vaut null, modification sinon
	 * (modification 27/09/2026, ajout 29/09/2026 — le formulaire d'ajout était
	 * auparavant déplié en permanence dans la page, ce qui noyait le carnet).
	 *
	 * Un seul formulaire pour les deux cas : seule change la destination de
	 * l'envoi, POST pour une création, PUT sur l'identifiant sinon.
	 */
	function fenetreAdresse(adresse: Adresse | null): void {
		const creation = adresse === null;
		const { boite, titre } = fenetre(creation ? "Ajouter une adresse" : "Modifier l'adresse");

		const formulaire = el("form", "p-6");
		formulaire.append(
			titre,
			champ("libelle", "Intitulé (facultatif)", "text", adresse?.libelle ?? ""),
			champ("ligne1", "Adresse", "text", adresse?.ligne1 ?? ""),
			champ("ligne2", "Complément (facultatif)", "text", adresse?.ligne2 ?? ""),
			champ("code_postal", "Code postal", "text", adresse?.code_postal ?? ""),
			champ("ville", "Ville", "text", adresse?.ville ?? ""),
			champ("telephone", "Téléphone (facultatif)", "tel", adresse?.telephone ?? ""),
		);

		const msg = messagerie();
		const actions = el("div", "flex flex-wrap items-center gap-4");
		const annuler = lienBouton("Annuler");
		annuler.className += " mt-5";
		annuler.addEventListener("click", () => boite.close());
		actions.append(boutonPrincipal(creation ? "Ajouter cette adresse" : "Enregistrer"), annuler);
		formulaire.append(actions, msg.noeud);

		formulaire.addEventListener("submit", async (evenement) => {
			evenement.preventDefault();
			msg.dire("Enregistrement…");
			const donnees = {
				libelle: valeur(formulaire, "libelle"),
				ligne1: valeur(formulaire, "ligne1"),
				ligne2: valeur(formulaire, "ligne2"),
				code_postal: valeur(formulaire, "code_postal"),
				ville: valeur(formulaire, "ville"),
				pays: adresse?.pays ?? "FR",
				telephone: valeur(formulaire, "telephone"),
			};
			const reponse = creation
				? await envoyer("/api/compte-adresses.php", "POST", donnees)
				: await envoyer(`/api/compte-adresses.php?id=${adresse.id}`, "PUT", donnees);

			if (reponse.ok) {
				boite.close();
				void afficher();
			} else {
				const champs = reponse.donnees.champs ?? {};
				const premier = Object.values(champs)[0];
				msg.dire(typeof premier === "string" ? premier : (reponse.donnees.error ?? "Adresse refusée."), true);
			}
		});

		ouvrir(boite, formulaire);
	}

	// ── Écrans ───────────────────────────────────────────────────────────

	function ecranConnexion(fournisseurs: Fournisseur[]): HTMLElement {
		const bloc = el("div");

		// Connexion
		const connexion = carte("Se connecter");

		// Les boutons sociaux d'abord : c'est le chemin le plus court pour qui en
		// dispose, et il évite un mot de passe de plus à retenir.
		const sociaux = boutonsSociaux(fournisseurs, "/compte/");
		if (sociaux) {
			connexion.append(sociaux, el("p", "t-petit mt-5 text-brun-400", "ou avec une adresse email"));
		}
		const fConnexion = el("form");
		fConnexion.append(champ("email", "Adresse email", "email"), champ("motdepasse", "Mot de passe", "password"));
		const msgConnexion = messagerie();
		fConnexion.append(boutonPrincipal("Se connecter"), msgConnexion.noeud);
		connexion.append(fConnexion);

		const oubli = lienBouton("Mot de passe oublié ?");
		oubli.className += " mt-4 block";
		connexion.append(oubli);
		bloc.append(connexion);

		fConnexion.addEventListener("submit", async (evenement) => {
			evenement.preventDefault();
			msgConnexion.dire("Connexion…");
			const reponse = await envoyer("/api/compte-connexion.php", "POST", {
				email: valeur(fConnexion, "email"),
				motdepasse: valeur(fConnexion, "motdepasse"),
			});
			if (reponse.ok) {
				void afficher();
			} else {
				msgConnexion.dire(reponse.donnees.error ?? "Connexion impossible.", true);
			}
		});

		oubli.addEventListener("click", () => {
			const formulaire = el("form", "mt-4");
			formulaire.append(champ("email", "Votre adresse email", "email"));
			const msg = messagerie();
			formulaire.append(boutonPrincipal("Envoyer le lien"), msg.noeud);
			oubli.replaceWith(formulaire);

			formulaire.addEventListener("submit", async (evenement) => {
				evenement.preventDefault();
				msg.dire("Envoi…");
				await envoyer("/api/compte-motdepasse-oublie.php", "POST", { email: valeur(formulaire, "email") });
				// Réponse volontairement identique quoi qu'il arrive : elle ne doit
				// pas révéler si l'adresse correspond à un compte.
				msg.dire("Si un compte existe pour cette adresse, un lien vient d'être envoyé. Il est valable une heure.");
			});
		});

		// Inscription
		const inscription = carte("Créer un compte");
		const fInscription = el("form");
		fInscription.append(
			champ("prenom", "Prénom"),
			champ("nom", "Nom"),
			champ("email", "Adresse email", "email"),
			champ("motdepasse", "Mot de passe (10 caractères minimum)", "password"),
		);
		const msgInscription = messagerie();
		fInscription.append(boutonPrincipal("Créer mon compte"), msgInscription.noeud);
		inscription.append(fInscription);
		bloc.append(inscription);

		fInscription.addEventListener("submit", async (evenement) => {
			evenement.preventDefault();
			msgInscription.dire("Création…");

			const identifiants = {
				email: valeur(fInscription, "email"),
				motdepasse: valeur(fInscription, "motdepasse"),
			};

			const creation = await envoyer("/api/compte-inscription.php", "POST", {
				...identifiants,
				prenom: valeur(fInscription, "prenom"),
				nom: valeur(fInscription, "nom"),
			});

			if (!creation.ok) {
				const champs = creation.donnees.champs ?? {};
				const premier = Object.values(champs)[0];
				msgInscription.dire(
					typeof premier === "string" ? premier : (creation.donnees.error ?? "Création impossible."),
					true,
				);
				return;
			}

			// L'inscription ne connecte pas : elle répond la même chose que
			// l'adresse soit libre ou déjà prise, pour ne pas révéler l'existence
			// d'un compte. On enchaîne donc sur une connexion ordinaire, qui
			// réussit si le compte vient d'être créé.
			const connexionAuto = await envoyer("/api/compte-connexion.php", "POST", identifiants);
			if (connexionAuto.ok) {
				void afficher();
			} else {
				msgInscription.dire(
					"Cette adresse est peut-être déjà associée à un compte. Essayez de vous connecter.",
					true,
				);
			}
		});

		return bloc;
	}

	function ecranReinitialisation(jetonReinit: string): HTMLElement {
		const bloc = carte("Choisir un nouveau mot de passe");
		const formulaire = el("form");
		formulaire.append(champ("motdepasse", "Nouveau mot de passe (10 caractères minimum)", "password"));
		const msg = messagerie();
		formulaire.append(boutonPrincipal("Enregistrer"), msg.noeud);
		bloc.append(formulaire);

		formulaire.addEventListener("submit", async (evenement) => {
			evenement.preventDefault();
			msg.dire("Enregistrement…");
			const reponse = await envoyer("/api/compte-motdepasse-reinit.php", "POST", {
				jeton: jetonReinit,
				motdepasse: valeur(formulaire, "motdepasse"),
			});

			if (reponse.ok) {
				// Le jeton disparaît de l'URL : il ne sert plus, et il n'a rien à
				// faire dans l'historique du navigateur.
				history.replaceState(null, "", "/compte/");
				msg.dire("Mot de passe modifié. Vous pouvez vous connecter.");
				window.setTimeout(() => void afficher(), 1200);
			} else {
				const champs = reponse.donnees.champs ?? {};
				const premier = Object.values(champs)[0];
				msg.dire(typeof premier === "string" ? premier : (reponse.donnees.error ?? "Lien invalide."), true);
			}
		});

		return bloc;
	}

	type Commande = {
		numero: string;
		statut: string;
		statut_libelle: string;
		total_cents: number;
		payment_mode: string;
		created_at: string;
		updated_at: string;
	};

	type LigneCommande = {
		libelle: string;
		quantite: number;
		prix_unitaire_cents: number;
		total_cents: number;
	};

	type CommandeDetail = Commande & { adresse_livraison: string; lignes: LigneCommande[] };

	/**
	 * Étapes du suivi, dans l'ordre du cycle de vie. La liste reprend celle de
	 * commandeStatuts() (public/lib/commandes.php) : si un statut y est ajouté,
	 * il doit l'être ici aussi, faute de quoi la commande n'aurait plus d'étape
	 * courante et le suivi s'afficherait entièrement grisé.
	 */
	const ETAPES_COMMANDE: { cle: string; titre: string }[] = [
		{ cle: "en_attente_paiement", titre: "Commande enregistrée" },
		{ cle: "payee", titre: "Paiement reçu" },
		{ cle: "en_fabrication", titre: "En fabrication" },
		{ cle: "prete", titre: "Prête" },
		{ cle: "expediee", titre: "Expédiée" },
		{ cle: "livree", titre: "Livrée" },
	];

	/** Statuts qui interrompent le parcours au lieu de le poursuivre. */
	const FINS_COMMANDE: Record<string, string> = {
		annulee: "Commande annulée",
		remboursee: "Commande remboursée",
	};

	/**
	 * Suivi d'avancement d'une commande, en étapes successives.
	 *
	 * La base ne conserve que le statut courant et la date de son dernier
	 * changement : on peut donc dater la première étape et la dernière atteinte,
	 * pas celles du milieu. Mieux vaut ne rien afficher que d'inventer une date.
	 */
	function suivi(commande: Commande): HTMLElement {
		const interrompue = FINS_COMMANDE[commande.statut];
		const etapes = interrompue
			? [ETAPES_COMMANDE[0], { cle: commande.statut, titre: interrompue }]
			: ETAPES_COMMANDE;
		const courante = interrompue ? etapes.length - 1 : etapes.findIndex((e) => e.cle === commande.statut);

		const liste = el("ol", "mt-5");
		etapes.forEach((etape, rang) => {
			const faite = rang < courante;
			const ici = rang === courante;
			const derniere = rang === etapes.length - 1;

			const item = el("li", "flex gap-3");

			// Colonne du fil : la pastille, puis un trait qui s'étire jusqu'à
			// l'étape suivante. Rien sous la dernière.
			const fil = el("div", "flex flex-col items-center");
			const pastille = el(
				"span",
				`mt-1.5 block size-3 shrink-0 rounded-full ${
					ici
						? "bg-rouille-500 ring-4 ring-rouille-500/20"
						: faite
							? "bg-brun-600"
							: "border border-ardoise/50 bg-ecru-50"
				}`,
			);
			fil.append(pastille);
			// Le trait déjà parcouru est plus appuyé que celui qui reste : à
			// 40 % sur un fond crème, un filet d'un pixel ne se voyait pas.
			if (!derniere) {
				fil.append(el("span", `my-1 w-px flex-1 ${rang < courante ? "bg-brun-600/60" : "bg-ardoise/50"}`));
			}
			item.append(fil);

			const texte = el("div", derniere ? "" : "pb-5");
			texte.append(
				el(
					"p",
					`t-petit font-semibold ${ici || faite ? "text-brun-700" : "text-brun-400"}`,
					etape.titre,
				),
			);

			// Première étape : la date de la commande. Étape courante : celle du
			// dernier changement de statut, quand le serveur la connaît.
			const quand =
				rang === 0
					? dateLisible(commande.created_at)
					: ici && commande.updated_at
						? dateLisible(commande.updated_at)
						: "";
			if (quand) texte.append(el("p", "t-petit text-brun-400", quand));

			if (ici) item.setAttribute("aria-current", "step");
			item.append(texte);
			liste.append(item);
		});

		if (interrompue) {
			liste.append(
				el(
					"p",
					"t-petit mt-2 text-brun-400",
					"Le détail des étapes précédentes n'est pas conservé.",
				),
			);
		}

		return liste;
	}

	/**
	 * Détail d'une commande : suivi d'avancement, articles et adresse.
	 *
	 * Les lignes ne sont pas dans la liste renvoyée au chargement de la page :
	 * elles sont demandées au clic, pour la seule commande ouverte.
	 */
	async function fenetreCommande(numero: string): Promise<void> {
		const { boite, titre } = fenetre(`Commande ${numero}`);
		const corps = el("div", "p-6");
		const etat = el("p", "t-petit mt-4 text-brun-400", "Chargement…");
		etat.setAttribute("role", "status");
		corps.append(titre, etat);
		ouvrir(boite, corps);

		const reponse = await envoyer(`/api/commandes.php?numero=${encodeURIComponent(numero)}`, "GET");
		if (!reponse.ok || !reponse.donnees.commande) {
			etat.className = "t-petit mt-4 text-rouille-500";
			etat.textContent = reponse.donnees.error ?? "Commande introuvable.";
			return;
		}

		const commande = reponse.donnees.commande as CommandeDetail;
		etat.remove();

		const entete = el("p", "t-petit mt-1 text-brun-500", `Passée le ${dateLisible(commande.created_at)}`);
		if (commande.payment_mode === "test") {
			entete.append(
				el(
					"span",
					"ml-2 rounded-full bg-rouille-500 px-2 py-0.5 text-[0.65rem] font-semibold text-ecru-50",
					"TEST",
				),
			);
		}
		corps.append(entete, suivi(commande));

		const articles = el("div", "mt-6 border-t border-ardoise/20 pt-4");
		articles.append(el("h3", "t-petit font-semibold text-brun-600", "Articles"));
		(commande.lignes ?? []).forEach((ligne) => {
			const rangee = el("div", "mt-2 flex items-baseline justify-between gap-4");
			rangee.append(
				el("p", "t-petit text-brun-500", ligne.quantite > 1 ? `${ligne.libelle} × ${ligne.quantite}` : ligne.libelle),
				el("p", "t-petit shrink-0 text-brun-600", formaterCents(ligne.total_cents)),
			);
			articles.append(rangee);
		});
		const total = el("div", "mt-3 flex items-baseline justify-between gap-4 border-t border-ardoise/20 pt-3");
		total.append(
			el("p", "t-petit font-semibold text-brun-700", "Total"),
			el("p", "font-semibold text-brun-700", `${formaterCents(commande.total_cents)} TTC`),
		);
		articles.append(total);
		corps.append(articles);

		if (commande.adresse_livraison) {
			const livraison = el("div", "mt-6 border-t border-ardoise/20 pt-4");
			livraison.append(el("h3", "t-petit font-semibold text-brun-600", "Livraison"));
			// L'adresse est enregistrée telle qu'elle était au moment de la
			// commande, en texte multiligne : une ligne par <p>.
			commande.adresse_livraison
				.split("\n")
				.filter((l) => l.trim() !== "")
				.forEach((l) => livraison.append(el("p", "t-petit mt-1 text-brun-500", l)));
			corps.append(livraison);
		}

		const fermer = lienBouton("Fermer");
		fermer.className += " mt-6";
		fermer.addEventListener("click", () => boite.close());
		corps.append(fermer);
	}

	/**
	 * Écran affiché en arrivant depuis le lien reçu par email.
	 *
	 * Le jeton est posté, pas suivi en GET : un aperçu de lien ou un anti-virus
	 * de messagerie le consommerait avant que le client ne clique.
	 */
	function ecranVerification(jetonVerif: string): HTMLElement {
		const bloc = carte("Confirmation de votre adresse");
		const etat = el("p", "t-corps mt-4 text-brun-500", "Vérification en cours…");
		etat.setAttribute("role", "status");
		bloc.append(etat);

		void (async () => {
			const reponse = await envoyer("/api/compte-verifier-email.php", "POST", { jeton: jetonVerif });
			// Le jeton disparaît de l'URL : il ne sert plus, et n'a rien à faire
			// dans l'historique du navigateur.
			history.replaceState(null, "", "/compte/");

			if (reponse.ok) {
				etat.className = "t-corps mt-4 text-brun-700";
				etat.textContent = "Adresse confirmée. Vous pouvez maintenant passer commande.";
				window.setTimeout(() => void afficher(), 1500);
			} else {
				etat.className = "t-petit mt-4 text-rouille-500";
				etat.textContent = reponse.donnees.error ?? "Lien invalide.";
			}
		})();

		return bloc;
	}

	/** Bandeau tant que l'adresse n'est pas confirmée. */
	function bandeauVerification(): HTMLElement {
		const bloc = el("div", "mb-6 rounded-2xl border border-rouille-500/40 bg-rouille-500/5 p-5");
		bloc.append(
			el("p", "t-petit font-semibold text-rouille-500", "Adresse email non confirmée"),
			el(
				"p",
				"t-petit mt-1 text-brun-500",
				"Vous pouvez parcourir la boutique et remplir votre panier, mais pas passer commande : " +
					"nous devons pouvoir vous joindre au sujet d'une boîte fabriquée sur mesure. " +
					"Un lien vous a été envoyé à l'inscription.",
			),
		);

		const message = el("p", "t-petit mt-3 text-brun-500");
		message.setAttribute("role", "status");
		message.hidden = true;

		const renvoyer = lienBouton("Renvoyer le lien");
		renvoyer.className += " mt-3 block";
		renvoyer.addEventListener("click", async () => {
			renvoyer.disabled = true;
			const reponse = await envoyer("/api/compte-verification-renvoyer.php", "POST", {});
			message.textContent = reponse.ok
				? "Lien renvoyé. Pensez à regarder dans les indésirables."
				: (reponse.donnees.error ?? "Envoi impossible pour le moment.");
			message.hidden = false;
			if (!reponse.ok) renvoyer.disabled = false;
		});

		bloc.append(renvoyer, message);
		return bloc;
	}

	/** Carte « Comptes liés » : rattacher ou détacher Google et Facebook. */
	function carteIdentites(fournisseurs: Fournisseur[], identites: Identite[], motDePasseDefini: boolean): HTMLElement {
		const bloc = carte("Connexion avec Google ou Facebook");
		const message = el("p", "t-petit mt-3");
		message.setAttribute("role", "status");
		message.hidden = true;

		if (fournisseurs.length === 0) {
			bloc.append(el("p", "t-petit mt-4 text-brun-400", "Aucun service de connexion n'est disponible."));
			return bloc;
		}

		fournisseurs.forEach((f) => {
			const liee = identites.find((i) => i.fournisseur === f.id);
			const ligne = el("div", "mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-ardoise/20 pt-4");

			const texte = el("div");
			texte.append(el("p", "font-display font-semibold text-brun-700", f.nom));
			texte.append(
				el("p", "t-petit text-brun-500", liee ? `Rattaché — ${liee.email}` : "Non rattaché"),
			);
			ligne.append(texte);

			if (liee) {
				const detacher = lienBouton("Détacher");
				detacher.addEventListener("click", async () => {
					const reponse = await envoyer(
						`/api/compte-identite.php?fournisseur=${encodeURIComponent(f.id)}`,
						"DELETE",
					);
					if (reponse.ok) {
						void afficher();
						return;
					}
					message.textContent = reponse.donnees.error ?? "Impossible de détacher ce compte.";
					message.className = "t-petit mt-3 text-rouille-500";
					message.hidden = false;
				});
				ligne.append(detacher);
			} else {
				const rattacher = el(
					"a",
					"t-petit text-brun-500 underline transition-colors hover:text-rouille-500",
					"Rattacher",
				);
				rattacher.href = `/api/oauth-demarrer.php?fournisseur=${encodeURIComponent(f.id)}&retour=/compte/`;
				ligne.append(rattacher);
			}

			bloc.append(ligne);
		});

		if (!motDePasseDefini) {
			bloc.append(
				el(
					"p",
					"t-petit mt-4 text-brun-500",
					"Votre compte n'a pas de mot de passe. Pour en définir un, utilisez « mot de passe oublié » " +
						"depuis la page de connexion : le lien reçu par email vous permettra d'en choisir un.",
				),
			);
		}

		bloc.append(message);
		return bloc;
	}

	function ecranClient(
		client: Client,
		adresses: Adresse[],
		commandes: Commande[],
		verifie: boolean,
		fournisseurs: Fournisseur[],
		identites: Identite[],
		motDePasseDefini: boolean,
	): HTMLElement {
		const bloc = el("div");
		if (!verifie) bloc.append(bandeauVerification());

		// Coordonnées
		const identite = carte("Coordonnées");
		const nomComplet = `${client.prenom} ${client.nom}`.trim();
		identite.append(
			el("p", "t-corps mt-4 text-brun-700", nomComplet === "" ? client.email : nomComplet),
			el("p", "t-petit text-brun-500", client.email),
		);
		const deconnexion = lienBouton("Se déconnecter");
		deconnexion.className += " mt-5 block";
		identite.append(deconnexion);
		bloc.append(identite);

		deconnexion.addEventListener("click", async () => {
			await envoyer("/api/compte-deconnexion.php", "POST", {});
			void afficher();
		});

		// Adresses
		const carnet = carte("Adresses");
		if (adresses.length === 0) {
			carnet.append(el("p", "t-petit mt-4 text-brun-400", "Aucune adresse enregistrée."));
		}
		adresses.forEach((adresse) => {
			const ligne = el("div", "mt-4 flex items-start justify-between gap-4 border-t border-ardoise/20 pt-4");
			const texte = el("div");
			if (adresse.libelle) texte.append(el("p", "t-petit font-semibold text-brun-600", adresse.libelle));
			texte.append(
				el("p", "t-petit text-brun-500", adresse.ligne1),
				...(adresse.ligne2 ? [el("p", "t-petit text-brun-500", adresse.ligne2)] : []),
				el("p", "t-petit text-brun-500", `${adresse.code_postal} ${adresse.ville} (${adresse.pays})`),
			);
			ligne.append(texte);

			const modifier = lienBouton("Modifier");
			modifier.addEventListener("click", () => fenetreAdresse(adresse));

			const supprimer = lienBouton("Supprimer");
			supprimer.addEventListener("click", async () => {
				await envoyer(`/api/compte-adresses.php?id=${adresse.id}`, "DELETE");
				void afficher();
			});

			const actionsAdresse = el("div", "flex shrink-0 gap-4");
			actionsAdresse.append(modifier, supprimer);
			ligne.append(actionsAdresse);
			carnet.append(ligne);
		});

		// Le formulaire d'ajout est passé en fenêtre le 29/09/2026 : déplié en
		// permanence, ses six champs vides occupaient plus de place que le carnet
		// lui-même et repoussaient les commandes hors de l'écran.
		const ajouter = boutonPrincipal("Ajouter une adresse");
		ajouter.type = "button";
		ajouter.addEventListener("click", () => fenetreAdresse(null));
		carnet.append(ajouter);
		bloc.append(carnet);

		// Commandes
		const historique = carte("Commandes");
		if (commandes.length === 0) {
			historique.append(el("p", "t-petit mt-4 text-brun-400", "Aucune commande pour l'instant."));
		}
		commandes.forEach((commande) => {
			// La ligne entière est un bouton : elle n'accueille donc que du
			// contenu de phrasé, d'où les <span> en bloc plutôt que des <p>.
			const ligne = el(
				"button",
				"mt-4 flex w-full flex-wrap items-baseline justify-between gap-2 border-t border-ardoise/20 pt-4 text-left transition-colors hover:border-rouille-400",
			);
			ligne.type = "button";
			ligne.addEventListener("click", () => void fenetreCommande(commande.numero));

			const gauche = el("span", "block");
			const titre = el("span", "block font-display font-semibold text-brun-700", commande.numero);
			if (commande.payment_mode === "test") {
				// Une commande de test n'a donné lieu à aucun encaissement : le
				// client doit le voir aussi, pas seulement l'administration.
				const badge = el("span", "ml-2 rounded-full bg-rouille-500 px-2 py-0.5 text-[0.65rem] font-semibold text-ecru-50", "TEST");
				titre.append(badge);
			}
			gauche.append(
				titre,
				el("span", "t-petit block text-brun-500", dateLisible(commande.created_at)),
				el("span", "t-petit block text-rouille-500", "Voir le suivi"),
			);
			ligne.append(gauche);

			const droite = el("span", "block text-right");
			droite.append(
				el("span", "block font-semibold text-brun-700", `${formaterCents(commande.total_cents)} TTC`),
				el("span", "t-petit block text-brun-500", commande.statut_libelle),
			);
			ligne.append(droite);
			historique.append(ligne);
		});
		bloc.append(historique);

		bloc.append(carteIdentites(fournisseurs, identites, motDePasseDefini));

		// Suppression
		const fin = carte("Supprimer mon compte");
		fin.append(
			el(
				"p",
				"t-petit mt-4 text-brun-500",
				"Vos coordonnées et vos adresses sont effacées. Les commandes déjà passées sont conservées sans vous identifier, comme la comptabilité l'exige. L'opération est définitive.",
			),
		);
		const fSuppression = el("form", "mt-2");
		// Un compte créé par Google ou Facebook n'a pas de mot de passe : lui en
		// demander un rendrait la suppression impossible. On confirme alors en
		// retapant son adresse, ce qui reste une action délibérée.
		fSuppression.append(
			motDePasseDefini
				? champ("motdepasse", "Confirmez avec votre mot de passe", "password")
				: champ("email", "Confirmez en saisissant votre adresse email", "email"),
		);
		const msgSuppression = messagerie();
		const boutonSuppression = boutonPrincipal("Supprimer définitivement");
		boutonSuppression.className = boutonSuppression.className.replace("bg-rouille-500", "bg-brun-700").replace("hover:bg-rouille-400", "hover:bg-brun-600");
		fSuppression.append(boutonSuppression, msgSuppression.noeud);
		fin.append(fSuppression);
		bloc.append(fin);

		fSuppression.addEventListener("submit", async (evenement) => {
			evenement.preventDefault();
			if (!window.confirm("Supprimer définitivement votre compte ?")) return;
			msgSuppression.dire("Suppression…");
			const reponse = await envoyer(
				"/api/compte-suppression.php",
				"POST",
				motDePasseDefini
					? { motdepasse: valeur(fSuppression, "motdepasse") }
					: { email: valeur(fSuppression, "email") },
			);
			if (reponse.ok) {
				void afficher();
			} else {
				msgSuppression.dire(reponse.donnees.error ?? "Suppression impossible.", true);
			}
		});

		return bloc;
	}

	// ── Aiguillage ───────────────────────────────────────────────────────

	async function afficher(): Promise<void> {
		if (!zone) return;

		jeton = await jetonCsrf(true);
		if (!jeton) {
			zone.replaceChildren(el("p", "t-petit text-brun-400", "Espace client indisponible pour le moment."));
			return;
		}

		const parametres = new URLSearchParams(window.location.search);

		const reinit = parametres.get("reinit");
		if (reinit) {
			zone.replaceChildren(ecranReinitialisation(reinit));
			return;
		}

		const verif = parametres.get("verif");
		if (verif) {
			zone.replaceChildren(ecranVerification(verif));
			return;
		}

		const etat = await envoyer("/api/compte.php", "GET");
		const fournisseurs = (etat.donnees.fournisseurs ?? []) as Fournisseur[];

		// Retour d'une connexion Google ou Facebook : le motif arrive dans l'URL,
		// le fournisseur nous ayant renvoyés par une redirection.
		const motifOauth = parametres.get("oauth");
		const messageOauth = motifOauth ? (MESSAGES_OAUTH[motifOauth] ?? "Connexion impossible.") : "";
		if (motifOauth) {
			history.replaceState(null, "", window.location.pathname + (parametres.get("retour") ? `?retour=${parametres.get("retour")}` : ""));
		}

		if (!etat.ok || etat.donnees.connecte !== true) {
			const ecran = ecranConnexion(fournisseurs);
			if (messageOauth !== "") ecran.prepend(bandeauMessage(messageOauth));
			zone.replaceChildren(ecran);
			return;
		}

		// Retour au tunnel de commande, quand on vient de là. Seuls les chemins
		// internes sont suivis : un « retour » vers un autre site ferait de cette
		// page une rampe de lancement vers n'importe où.
		const retour = new URLSearchParams(window.location.search).get("retour");
		if (retour && /^\/[a-z0-9/_-]*$/i.test(retour)) {
			window.location.replace(retour);
			return;
		}

		const carnet = await envoyer("/api/compte-adresses.php", "GET");
		const historique = await envoyer("/api/commandes.php", "GET");

		const ecran = ecranClient(
			etat.donnees.client as Client,
			(carnet.donnees.adresses ?? []) as Adresse[],
			(historique.donnees.commandes ?? []) as Commande[],
			etat.donnees.email_verifie === true,
			fournisseurs,
			(etat.donnees.identites ?? []) as Identite[],
			etat.donnees.mot_de_passe_defini !== false,
		);
		if (messageOauth !== "") ecran.prepend(bandeauMessage(messageOauth));

		zone.replaceChildren(ecran);
	}

	/** Bandeau d'information en tête d'écran, pour un retour de connexion sociale. */
	function bandeauMessage(texte: string): HTMLElement {
		const bloc = el("div", "mb-6 rounded-2xl border border-ardoise/30 bg-sable/50 p-4");
		bloc.setAttribute("role", "status");
		bloc.append(el("p", "t-petit text-brun-600", texte));
		return bloc;
	}

	/** Date ISO-8601 UTC rendue lisible en heure locale. */
	function dateLisible(iso: string): string {
		const date = new Date(iso);
		return Number.isNaN(date.getTime())
			? ""
			: date.toLocaleDateString("fr-FR", { day: "2-digit", month: "long", year: "numeric" });
	}

	void afficher();
</script>
