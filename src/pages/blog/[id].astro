---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" });
---

<Layout title={post.data.title} description={post.data.description}>
	<article class="mx-auto max-w-3xl px-6 py-16">
		<a href="/blog" class="text-sm font-semibold text-rouille-500">← Retour au blog</a>
		<p class="mt-6 text-sm text-brun-400">{dateFormatter.format(post.data.pubDate)}</p>
		<h1 class="mt-2 font-display text-3xl font-semibold text-brun-700 sm:text-4xl">
			{post.data.title}
		</h1>
		<div
			class="prose prose-headings:font-display prose-headings:text-brun-700 prose-p:text-brun-600 prose-a:text-rouille-500 mt-10 max-w-none"
		>
			<Content />
		</div>
	</article>
</Layout>
