---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { SOCIAL_LINKS } from "../../consts";
import rawSocialData from "../../data/social-posts.json";

interface SocialPost {
	id: string;
	source: "instagram" | "facebook";
	text: string;
	image: string | null;
	url: string;
	date: string;
}

const socialData = rawSocialData as { updatedAt: string | null; posts: SocialPost[] };

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFormatter = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" });

const socialPosts = socialData.posts.slice(0, 6);

const sourceIcon: Record<string, string> = {
	instagram: "tabler:brand-instagram",
	facebook: "tabler:brand-facebook",
};

function excerpt(text: string, maxLength = 140) {
	if (text.length <= maxLength) return text;
	return `${text.slice(0, maxLength).trimEnd()}…`;
}
---

<Layout title="Blog">
	<section class="border-b border-kaki-200 bg-kaki-100/50 px-6 py-16">
		<div class="mx-auto max-w-4xl">
			<p class="text-xs font-medium uppercase tracking-widest text-rouille-500">Blog</p>
			<h1 class="mt-3 font-display text-4xl font-semibold text-brun-700">Carnet de bord</h1>
			<p class="mt-6 max-w-2xl text-lg text-brun-500">
				Coulisses de fabrication, retours d'expérience et actualités de La Boîte à Bivouac.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-16">
		<ul class="flex flex-col divide-y divide-kaki-200">
			{
				posts.map((post) => (
					<li class="py-8 first:pt-0">
						<a href={`/blog/${post.id}/`} class="group block">
							<p class="text-sm text-brun-400">
								{dateFormatter.format(post.data.pubDate)}
							</p>
							<h2 class="mt-2 font-display text-2xl font-semibold text-brun-700 group-hover:text-rouille-500">
								{post.data.title}
							</h2>
							<p class="mt-3 text-brun-500">{post.data.description}</p>
							<span class="mt-4 inline-block text-sm font-semibold text-rouille-500">
								Lire l'article →
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="border-t border-kaki-200 bg-kaki-100/50 px-6 py-16">
		<div class="mx-auto max-w-4xl">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<p class="text-xs font-medium uppercase tracking-widest text-rouille-500">
						Réseaux sociaux
					</p>
					<h2 class="mt-2 font-display text-2xl font-semibold text-brun-700">
						Suivez nos actualités
					</h2>
				</div>
				<ul class="flex gap-3" aria-label="Réseaux sociaux">
					{
						SOCIAL_LINKS.map((social) => (
							<li>
								<a
									href={social.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={social.label}
									class="flex h-9 w-9 items-center justify-center rounded-full border border-kaki-300 text-brun-600 transition-colors hover:border-rouille-400 hover:bg-rouille-500 hover:text-ecru-50"
								>
									<Icon name={social.icon} class="h-5 w-5" />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			{
				socialPosts.length > 0 ? (
					<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{socialPosts.map((post) => (
							<a
								href={post.url}
								target="_blank"
								rel="noopener noreferrer"
								class="group flex flex-col overflow-hidden rounded-xl border border-kaki-200 bg-ecru-50 transition-shadow hover:shadow-md"
							>
								{post.image ? (
									<img
										src={post.image}
										alt=""
										loading="lazy"
										class="aspect-video w-full object-cover"
									/>
								) : (
									<div class="flex aspect-video w-full items-center justify-center bg-kaki-200">
										<Icon name={sourceIcon[post.source]} class="h-8 w-8 text-brun-500" />
									</div>
								)}
								<div class="flex flex-1 flex-col p-5">
									<span class="flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-brun-400">
										<Icon name={sourceIcon[post.source]} class="h-4 w-4" />
										{post.source === "instagram" ? "Instagram" : "Facebook"}
									</span>
									<p class="mt-3 flex-1 text-sm text-brun-600">{excerpt(post.text)}</p>
									<span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-rouille-500 group-hover:underline">
										Voir la publication
										<Icon name="tabler:arrow-right" class="h-4 w-4" />
									</span>
								</div>
							</a>
						))}
					</div>
				) : (
					<p class="mt-8 text-brun-500">
						Nos dernières publications s'affichent ici automatiquement. En attendant, retrouvez-nous
						directement sur Facebook et Instagram.
					</p>
				)
			}
		</div>
	</section>
</Layout>
