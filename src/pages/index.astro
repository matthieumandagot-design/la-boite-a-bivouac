---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { HOME_DESCRIPTION, HOME_TITLE } from "../consts";
import HeroVideo from "../components/HeroVideo.astro";
import ScrollReveal from "../components/ScrollReveal.astro";

/** Le parcours, en trois temps : de la remorque au dossier, du dossier à la Boîte. */
const ETAPES = [
	{
		icon: "tabler:ruler-measure",
		titre: "Configurez",
		texte:
			"Choisissez votre remorque parmi les modèles relevés, ou saisissez ses cotes intérieures. Réglez la hauteur de la Boîte : dimensions, volume et hauteur hors tout s'affichent aussitôt.",
	},
	{
		icon: "tabler:mail-opened",
		titre: "Recevez le dossier",
		texte:
			"Le plan de fabrication A3, les modèles 3D STEP et FreeCAD, la liste de débit et des aperçus, générés à vos cotes et envoyés par email. Gratuitement.",
	},
	{
		icon: "tabler:flame",
		titre: "Faites fabriquer",
		texte:
			"Soudez-la vous-même ou transférez le dossier à l'atelier de soudure de votre choix : le plan suffit pour chiffrer et fabriquer.",
	},
];

const ENGAGEMENTS = [
	{
		icon: "tabler:gift",
		titre: "Libre et gratuit",
		texte:
			"Les plans sont sous licence CC BY-SA 4.0 : utilisez-les, modifiez-les, partagez-les, y compris pour fabriquer, en citant le projet et en partageant vos améliorations.",
	},
	{
		icon: "tabler:arrow-loop-left",
		titre: "Équiper plutôt qu'acheter",
		texte:
			"Vous avez déjà une remorque ? Elle suffit. Pas besoin d'un van, d'une caravane ou d'une remorque aménagée : la Boîte s'installe dans ce que vous possédez.",
	},
	{
		icon: "tabler:map-pin",
		titre: "Fabriquée près de chez vous",
		texte:
			"Un dossier lisible par n'importe quel atelier de soudure : votre Boîte se fabrique au plus près de chez vous, plutôt qu'à l'autre bout du monde.",
	},
	{
		icon: "tabler:tool",
		titre: "Réparable, donc durable",
		texte:
			"Acier soudé, panneaux vissés, pièces standard. Un choc ou une usure se réparent : vous avez les plans de chaque pièce.",
	},
];
---

<Layout fullTitle={HOME_TITLE} description={HOME_DESCRIPTION}>
	<HeroVideo />
	<ScrollReveal />

	<section class="bg-ecru-100 px-6 py-20 sm:px-8 lg:px-12">
		<div>
			<p class="t-menu font-medium uppercase tracking-widest text-rouille-500" data-reveal>
				Comment ça marche
			</p>
			<h2
				class="mt-3 t-titre font-display font-semibold text-brun-700"
				data-reveal
				style="--reveal-delay: 60ms"
			>
				De vos cotes à votre Boîte, en trois temps.
			</h2>

			<ol class="mt-10 grid gap-6 md:grid-cols-3">
				{
					ETAPES.map((etape, index) => (
						<li
							class="relative rounded-2xl border border-ardoise/30 bg-ecru-50 p-6 shadow-sm"
							data-reveal
							style={`--reveal-delay: ${index * 90}ms`}
						>
							<span class="flex items-center gap-3">
								<span class="flex h-11 w-11 items-center justify-center rounded-full bg-rouille-500 text-ecru-50">
									<Icon name={etape.icon} class="h-5 w-5" />
								</span>
								<span class="font-display text-sm font-semibold uppercase tracking-widest text-brun-400">
									Étape {index + 1}
								</span>
							</span>
							<h3 class="mt-4 t-sous font-display font-semibold text-brun-700">{etape.titre}</h3>
							<p class="t-petit mt-2 text-brun-500">{etape.texte}</p>
						</li>
					))
				}
			</ol>

			<div class="mt-8" data-reveal>
				<a
					href="/configurateur/"
					class="inline-flex items-center gap-2 rounded-full bg-rouille-500 px-6 py-3 text-sm font-semibold text-ecru-50 shadow-sm transition-colors hover:bg-rouille-400"
				>
					Configurer ma Boîte et recevoir les plans
					<Icon name="tabler:arrow-right" class="h-4 w-4" />
				</a>
			</div>

			<div class="mt-14 grid gap-6 lg:grid-cols-3">
				<a
					href="/la-boite/"
					class="group overflow-hidden rounded-2xl border border-ardoise/30 bg-ecru-50 shadow-sm transition-all hover:-translate-y-1 hover:border-rouille-400 hover:shadow-lg lg:col-span-2"
					data-reveal
				>
					<img
						src="/images/accueil-tente.webp"
						alt="La Boîte à Bivouac sur sa remorque, tente de toit déployée"
						width="1280"
						height="720"
						loading="lazy"
						class="aspect-[16/9] w-full object-cover"
					/>
					<div class="p-8">
						<p class="t-menu font-medium uppercase tracking-widest text-rouille-500">
							Le projet
						</p>
						<h3 class="mt-3 t-titre font-display font-semibold text-brun-700">
							La Boîte à Bivouac
						</h3>
						<p class="mt-3 text-brun-500">
							Une caisse amovible qui s'installe dans votre remorque standard et la transforme
							en base de bivouac. Quand l'aventure est finie, elle se retire et la remorque
							redevient une remorque. Conçue, fabriquée et testée en Occitanie, puis partagée.
						</p>
						<span class="mt-6 inline-flex items-center gap-2 rounded-full bg-rouille-500 px-5 py-2.5 text-sm font-semibold text-ecru-50 transition-colors group-hover:bg-rouille-400">
							Découvrir la Boîte
							<Icon
								name="tabler:arrow-right"
								class="h-4 w-4 transition-transform group-hover:translate-x-1"
							/>
						</span>
					</div>
				</a>

				<a
					href="/equipements/"
					class="group flex flex-col rounded-2xl border border-dashed border-ardoise/50 bg-sable/40 p-8 transition-all hover:border-rouille-400 hover:bg-sable/60"
					data-reveal
					style="--reveal-delay: 120ms"
				>
					<span class="flex h-11 w-11 items-center justify-center rounded-full bg-ecru-50 text-rouille-500">
						<Icon name="tabler:tent" class="h-5 w-5" />
					</span>
					<p class="mt-5 t-menu font-medium uppercase tracking-widest text-brun-400">
						Pour aller plus loin
					</p>
					<h3 class="mt-2 t-sous font-display font-semibold text-brun-700">Les équipements</h3>
					<p class="t-petit mt-3 flex-1 text-brun-500">
						Tente de toit, porte-vélos, rangements : le matériel que nous avons testé, avec un
						prix indicatif, à acheter où vous voulez. La Boîte fonctionne très bien sans.
					</p>
					<span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-rouille-500">
						Voir les équipements
						<Icon
							name="tabler:arrow-right"
							class="h-4 w-4 transition-transform group-hover:translate-x-1"
						/>
					</span>
				</a>
			</div>
		</div>
	</section>

	<section class="bg-graphite px-6 py-20 text-ecru-50 sm:px-8 lg:px-12">
		<div>
			<p class="t-menu font-medium uppercase tracking-widest text-mousse" data-reveal>
				L'esprit du projet
			</p>
			<h2
				class="t-titre mt-3 max-w-[80ch] font-display font-semibold"
				data-reveal
				style="--reveal-delay: 60ms"
			>
				Un projet ouvert, pour du matériel qui dure et se répare.
			</h2>

			<div class="mt-12 grid gap-10 sm:grid-cols-2">
				{
					ENGAGEMENTS.map((item, index) => (
						<div class="flex items-start gap-4" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
							<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-mousse text-sable">
								<Icon name={item.icon} class="h-6 w-6" />
							</span>
							<div>
								<h3 class="t-sous font-display font-semibold">{item.titre}</h3>
								<p class="mt-1 text-ecru-100/80">{item.texte}</p>
							</div>
						</div>
					))
				}
			</div>

			<div class="mt-16 border-t border-ecru-50/15 pt-14 text-center">
				<h2 class="t-titre font-display font-semibold" data-reveal>
					Vous avez une remorque. On vous donne la boîte.
				</h2>
				<p class="t-corps mx-auto mt-4 max-w-[80ch] text-ecru-100/80" data-reveal style="--reveal-delay: 90ms">
					Une question sur les plans, une amélioration à partager, ou vous préférez que nous
					prenions en charge la fabrication&nbsp;? Écrivez-nous, chaque message reçoit une réponse.
				</p>
				<a
					href="/contact/"
					class="bg-gold text-forest mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold shadow-sm transition-opacity hover:opacity-90"
					data-reveal
					style="--reveal-delay: 180ms"
				>
					Prendre contact
					<Icon name="tabler:arrow-right" class="h-4 w-4" />
				</a>
			</div>
		</div>
	</section>
</Layout>
