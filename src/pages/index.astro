---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { HOME_DESCRIPTION } from "../consts";
import HeroVideo from "../components/HeroVideo.astro";
import pine from "../components/icons/pine.svg?raw";
import bike from "../components/icons/bike.svg?raw";
import canoe from "../components/icons/canoe.svg?raw";

const PRINCIPLES = [
	{
		icon: "tabler:tent",
		title: "Sur le dessus",
		text: "Une tente de toit. Vous dormez en hauteur, partout où vous vous arrêtez.",
	},
	{
		icon: "tabler:box",
		title: "À l'intérieur",
		text: "Du volume pour les vélos, le matériel de camping et l'équipement outdoor.",
	},
	{
		icon: "tabler:puzzle",
		title: "Amovible",
		text: "La boîte se retire. La remorque redevient une remorque.",
	},
];

const PLAY_TERRAINS = [
	{ icon: pine, title: "Bivouac", text: "Forêt, montagne, bord de lac." },
	{ icon: bike, title: "Trail & VTT", text: "Les vélos rentrent. Le matériel aussi." },
	{ icon: canoe, title: "Côte & campings", text: "Base fixe, exploration mobile." },
];
---

<Layout description={HOME_DESCRIPTION}>
	<HeroVideo />

	<section class="bg-ecru-100 px-6 py-20">
		<div class="mx-auto max-w-5xl">
			<h2 class="font-display text-2xl font-semibold text-brun-700 sm:text-3xl">
				Un principe simple.
			</h2>
			<div class="mt-10 grid gap-8 sm:grid-cols-3">
				{
					PRINCIPLES.map((item) => (
						<article class="rounded-xl border border-ardoise/30 bg-ecru-50 p-6">
							<span class="flex h-12 w-12 items-center justify-center rounded-full bg-rouille-500 text-ecru-50">
								<Icon name={item.icon} class="h-6 w-6" />
							</span>
							<h3 class="mt-5 font-display text-lg font-semibold text-brun-700">{item.title}</h3>
							<p class="mt-2 text-brun-500">{item.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="border-y border-ardoise/30 bg-sable/50 px-6 py-20">
		<div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-2 lg:items-center">
			<img
				src="/images/produit-cote.jpeg"
				alt="La Boîte à Bivouac en situation"
				loading="lazy"
				class="aspect-[4/3] w-full rounded-2xl object-cover shadow-sm"
			/>
			<div>
				<h2 class="font-display text-2xl font-semibold text-brun-700 sm:text-3xl">
					Déjà testée en conditions réelles.
				</h2>
				<p class="mt-4 text-brun-500">
					La première version existe. Elle a roulé, bivouaqué et été testée pendant des semaines en
					conditions réelles. Les résultats de ces essais guident directement ce qui arrive ensuite.
				</p>
				<a
					href="/la-boite"
					class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-rouille-500 transition-colors hover:text-rouille-400"
				>
					Voir la Boîte
					<Icon name="tabler:arrow-right" class="h-4 w-4" />
				</a>
			</div>
		</div>
	</section>

	<section class="bg-graphite px-6 py-20 text-ecru-50">
		<div class="mx-auto max-w-5xl">
			<h2 class="font-display text-2xl font-semibold sm:text-3xl">Un module, des terrains</h2>
			<div class="mt-10 grid gap-8 sm:grid-cols-3">
				{
					PLAY_TERRAINS.map((terrain) => (
						<div class="flex items-center gap-4">
							<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-mousse text-sable">
								<span class="h-6 w-6 [&>svg]:h-full [&>svg]:w-full" set:html={terrain.icon} />
							</span>
							<div>
								<h3 class="font-display text-lg font-semibold">{terrain.title}</h3>
								<p class="mt-1 text-ecru-100/80">{terrain.text}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Layout>
