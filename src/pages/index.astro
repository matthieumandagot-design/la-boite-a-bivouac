---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { HOME_DESCRIPTION } from "../consts";
import HeroVideo from "../components/HeroVideo.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import pine from "../components/icons/pine.svg?raw";
import bike from "../components/icons/bike.svg?raw";
import canoe from "../components/icons/canoe.svg?raw";

const PRINCIPLES = [
	{
		icon: "tabler:tent",
		title: "Sur le dessus",
		text: "Des barres de toit intégrées, conçues pour supporter une tente de toit, un canoë, une planche à voile ou tout autre équipement encombrant.",
	},
	{
		icon: "tabler:box",
		title: "À l'intérieur",
		text: "Un espace fermé et verrouillé pour transporter vélos, matériel de camping et équipement outdoor en toute sécurité.",
	},
	{
		icon: "tabler:puzzle",
		title: "Amovible",
		text: "La boîte se retire. La remorque redevient une remorque.",
	},
];

const PLAY_TERRAINS = [
	{
		icon: pine,
		title: "Bivouac",
		text: "Forêt, montagne, bord de lac. Installez la tente de toit, ouvrez les portes, posez le camp. La Boîte à Bivouac fait de n'importe quel endroit votre base.",
	},
	{
		icon: bike,
		title: "Partez à 5.",
		text: "La tente de toit sur la Boîte accueille 3 personnes ou plus. Le véhicule, libéré du matériel, en loge 2 supplémentaires. L'aventure n'est plus réservée aux duos.",
	},
	{
		icon: canoe,
		title: "Côte & campings",
		text: "Base fixe, exploration mobile. La Boîte à Bivouac devient votre quartier général — vous repartez visiter la région avec un véhicule agile, sans compromis.",
	},
];
---

<Layout description={HOME_DESCRIPTION}>
	<HeroVideo />
	<ScrollReveal />

	<section class="bg-ecru-100 px-6 py-20">
		<div class="mx-auto max-w-5xl">
			<h2 class="font-display text-2xl font-semibold text-brun-700 sm:text-3xl" data-reveal>
				Un principe simple.
			</h2>
			<div class="mt-10 grid gap-8 sm:grid-cols-3">
				{
					PRINCIPLES.map((item, index) => (
						<article
							class="rounded-xl border border-ardoise/30 bg-ecru-50 p-6"
							data-reveal
							style={`--reveal-delay: ${index * 90}ms`}
						>
							<span class="flex h-12 w-12 items-center justify-center rounded-full bg-rouille-500 text-ecru-50">
								<Icon name={item.icon} class="h-6 w-6" />
							</span>
							<h3 class="mt-5 font-display text-lg font-semibold text-brun-700">{item.title}</h3>
							<p class="mt-2 text-brun-500">{item.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-graphite px-6 py-20 text-ecru-50">
		<div class="mx-auto max-w-5xl">
			<h2 class="font-display text-2xl font-semibold sm:text-3xl" data-reveal>
				Un module, des terrains
			</h2>
			<div class="mt-10 grid gap-8 sm:grid-cols-3">
				{
					PLAY_TERRAINS.map((terrain, index) => (
						<div
							class="flex items-start gap-4"
							data-reveal
							style={`--reveal-delay: ${index * 90}ms`}
						>
							<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-mousse text-sable">
								<span class="h-6 w-6 [&>svg]:h-full [&>svg]:w-full" set:html={terrain.icon} />
							</span>
							<div>
								<h3 class="font-display text-lg font-semibold">{terrain.title}</h3>
								<p class="mt-1 text-ecru-100/80">{terrain.text}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="border-y border-ardoise/30 bg-sable/50 px-6 py-20">
		<div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-2 lg:items-center">
			<img
				src="/images/produit-cote.jpeg"
				alt="La Boîte à Bivouac en situation"
				loading="lazy"
				class="aspect-[4/3] w-full rounded-2xl object-cover shadow-sm"
				data-reveal="left"
			/>
			<div data-reveal="right" style="--reveal-delay: 120ms">
				<h2 class="font-display text-2xl font-semibold text-brun-700 sm:text-3xl">
					Déjà testée en conditions réelles.
				</h2>
				<p class="mt-4 text-brun-500">
					La première version existe. Elle a roulé, bivouaqué et été testée pendant des semaines en
					conditions réelles. Les résultats de ces essais guident directement ce qui arrive ensuite.
				</p>
				<a
					href="/la-boite"
					class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-rouille-500 transition-colors hover:text-rouille-400"
				>
					Voir la Boîte
					<Icon name="tabler:arrow-right" class="h-4 w-4" />
				</a>
			</div>
		</div>
	</section>

	<section class="bg-ecru-100 px-6 py-20 text-center">
		<div class="mx-auto max-w-2xl">
			<p
				class="text-xs font-medium uppercase tracking-widest text-rouille-500"
				data-reveal
			>
				LE PRIX
			</p>
			<p
				class="mt-4 font-display text-2xl font-semibold text-brun-700 sm:text-3xl"
				data-reveal
				style="--reveal-delay: 90ms"
			>
				2&nbsp;000&nbsp;€.
			</p>
			<p class="mt-4 text-brun-500" data-reveal style="--reveal-delay: 180ms">
				C'est le prix de deux semaines de location en van aménagé. C'est aussi le prix d'une
				Boîte à Bivouac qui vous accompagne pendant des années.
			</p>
			<p class="mt-6 text-sm text-brun-400" data-reveal style="--reveal-delay: 240ms">
				*Prix de vente indicatif, susceptible de varier selon la configuration et les options
				choisies.
			</p>
		</div>
	</section>

	<section class="bg-graphite px-6 py-20 text-center text-ecru-50">
		<div class="mx-auto max-w-2xl">
			<h2 class="font-display text-2xl font-semibold sm:text-3xl" data-reveal>
				Vous avez une remorque. On a une boîte.
			</h2>
			<p class="mt-4 text-ecru-100/80" data-reveal style="--reveal-delay: 90ms">
				Parlez-nous de votre projet, de votre usage, de ce que vous transportez. On construira
				la suite ensemble.
			</p>
			<a
				href="/contact"
				class="bg-gold text-forest mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold shadow-sm transition-opacity hover:opacity-90"
				data-reveal
				style="--reveal-delay: 180ms"
			>
				Prendre contact
				<Icon name="tabler:arrow-right" class="h-4 w-4" />
			</a>
		</div>
	</section>
</Layout>
