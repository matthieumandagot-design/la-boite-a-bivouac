---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { HOME_DESCRIPTION } from "../consts";
import HeroVideo from "../components/HeroVideo.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Lightbox from "../components/Lightbox.astro";

// Deux passerelles seulement : l'accueil oriente, il n'explique pas le produit
// (c'est le rôle de /la-boite) ni le détail des équipements (/equipements).
const PASSERELLES = [
	{
		href: "/la-boite",
		icon: "tabler:box",
		titre: "La Boîte à Bivouac",
		texte:
			"Une caisse amovible qui s'installe dans votre remorque standard et la transforme en base de bivouac. Quand l'aventure est finie, elle se retire et la remorque redevient une remorque.",
		lien: "Découvrir la Boîte",
	},
	{
		href: "/equipements",
		icon: "tabler:tent",
		titre: "Les équipements",
		texte:
			"Tente de toit, porte-vélos, rangements : le matériel qui se monte sur la remorque, dans la Boîte ou sur ses barres de toit.",
		lien: "Voir les équipements",
	},
];

const ENGAGEMENTS = [
	{
		icon: "tabler:arrow-loop-left",
		titre: "Équiper plutôt qu'acheter",
		texte:
			"Vous avez déjà une remorque ? Elle suffit. Pas besoin d'un van, d'une caravane ou d'une remorque aménagée de plus : nous équipons ce que vous possédez.",
	},
	{
		icon: "tabler:map-pin",
		titre: "Fabriqué en Occitanie",
		texte:
			"Conception, soudure et assemblage se font dans notre atelier. Rien qui arrive par conteneur de l'autre bout du monde.",
	},
	{
		icon: "tabler:tool",
		titre: "Réparable, donc durable",
		texte:
			"Acier soudé, panneaux vissés, pièces remplaçables. Un choc ou une usure se réparent : rien n'oblige à tout remplacer.",
	},
	{
		icon: "tabler:tag",
		titre: "Un budget raisonnable",
		texte:
			"Le prix d'un équipement, pas celui d'un véhicule aménagé. Ce que vous payez part dans la matière et dans le travail, pas dans un réseau de distribution.",
	},
];
---

<Layout description={HOME_DESCRIPTION}>
	<HeroVideo />
	<ScrollReveal />
	<Lightbox />

	<section class="bg-ecru-100 px-6 py-20">
		<div class="mx-auto max-w-5xl">
			<p class="text-xs font-medium uppercase tracking-widest text-rouille-500" data-reveal>
				Ce que nous proposons
			</p>
			<h2
				class="mt-3 font-display text-2xl font-semibold text-brun-700 sm:text-3xl"
				data-reveal
				style="--reveal-delay: 60ms"
			>
				Deux façons de préparer votre bivouac.
			</h2>

			<div class="mt-10 grid gap-6 sm:grid-cols-2">
				{
					PASSERELLES.map((item, index) => (
						<a
							href={item.href}
							class="group flex flex-col rounded-2xl border border-ardoise/30 bg-ecru-50 p-8 transition-all hover:-translate-y-1 hover:border-rouille-400 hover:shadow-lg"
							data-reveal
							style={`--reveal-delay: ${index * 90}ms`}
						>
							<span class="flex h-12 w-12 items-center justify-center rounded-full bg-rouille-500 text-ecru-50">
								<Icon name={item.icon} class="h-6 w-6" />
							</span>
							<h3 class="mt-5 font-display text-xl font-semibold text-brun-700">{item.titre}</h3>
							<p class="mt-3 flex-1 text-brun-500">{item.texte}</p>
							<span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-rouille-500">
								{item.lien}
								<Icon
									name="tabler:arrow-right"
									class="h-4 w-4 transition-transform group-hover:translate-x-1"
								/>
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-graphite px-6 py-20 text-ecru-50">
		<div class="mx-auto max-w-5xl">
			<p class="text-xs font-medium uppercase tracking-widest text-mousse" data-reveal>
				Notre façon de faire
			</p>
			<h2
				class="mt-3 max-w-2xl font-display text-2xl font-semibold sm:text-3xl"
				data-reveal
				style="--reveal-delay: 60ms"
			>
				Du matériel fabriqué ici, fait pour durer et pour se réparer.
			</h2>

			<div class="mt-12 grid gap-10 sm:grid-cols-2">
				{
					ENGAGEMENTS.map((item, index) => (
						<div class="flex items-start gap-4" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
							<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-mousse text-sable">
								<Icon name={item.icon} class="h-6 w-6" />
							</span>
							<div>
								<h3 class="font-display text-lg font-semibold">{item.titre}</h3>
								<p class="mt-1 text-ecru-100/80">{item.texte}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-ecru-100 px-6 py-20 text-center">
		<div class="mx-auto max-w-2xl">
			<p class="text-xs font-medium uppercase tracking-widest text-rouille-500" data-reveal>
				Le juste prix
			</p>
			<p
				class="mt-4 font-display text-2xl font-semibold text-brun-700 sm:text-3xl"
				data-reveal
				style="--reveal-delay: 90ms"
			>
				2&nbsp;000&nbsp;€.
			</p>
			<p class="mt-4 text-brun-500" data-reveal style="--reveal-delay: 180ms">
				C'est le prix de deux semaines de location en van aménagé. C'est aussi le prix d'une
				Boîte à Bivouac qui vous accompagne pendant des années, et que l'on répare plutôt que
				de la remplacer.
			</p>
			<p class="mt-6 text-sm text-brun-400" data-reveal style="--reveal-delay: 240ms">
				*Prix de vente indicatif, susceptible de varier selon la configuration et les options
				choisies.
			</p>
		</div>
	</section>

	<section class="bg-graphite px-6 py-20 text-center text-ecru-50">
		<div class="mx-auto max-w-2xl">
			<h2 class="font-display text-2xl font-semibold sm:text-3xl" data-reveal>
				Vous avez une remorque. On a une boîte.
			</h2>
			<p class="mt-4 text-ecru-100/80" data-reveal style="--reveal-delay: 90ms">
				Parlez-nous de votre projet, de votre usage, de ce que vous transportez. On construira
				la suite ensemble.
			</p>
			<a
				href="/contact"
				class="bg-gold text-forest mt-8 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold shadow-sm transition-opacity hover:opacity-90"
				data-reveal
				style="--reveal-delay: 180ms"
			>
				Prendre contact
				<Icon name="tabler:arrow-right" class="h-4 w-4" />
			</a>
		</div>
	</section>
</Layout>
