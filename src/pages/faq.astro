---
import Layout from "../layouts/Layout.astro";
import { toJsonLd } from "../utils/jsonld";
// Import statique (build time) du même fichier que le fetch client utilise en
// repli (voir loadFaq() plus bas) : garantit que le JSON-LD généré au build
// reste identique au contenu par défaut réellement affiché aux visiteurs.
// N'inclut pas les éventuelles modifications live via /admin/faq.php
// (public/data/faq.json, non versionné) : penser à resynchroniser
// public/data/faq.default.json après toute édition FAQ en production, pour
// que ce schema conserve un contenu exact.
import faqData from "../../public/data/faq.default.json";

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqData.map((item: { question: string; answer: string }) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer,
		},
	})),
};
---

<Layout
	title="FAQ"
	fullTitle="FAQ — La Boîte à Bivouac"
	description="Compatibilité remorque, prix, installation, dimensions, garantie : 20 réponses aux questions les plus posées sur La Boîte à Bivouac."
>
	<script type="application/ld+json" set:html={toJsonLd(faqSchema)} />

	<section class="bg-ecru-100 px-6 py-16">
		<div class="w-full">
			<h1 class="font-display text-4xl font-semibold text-brun-600">Questions fréquentes</h1>
			<p class="mt-6 max-w-2xl text-lg text-brun-500">
				Tout ce que vous voulez savoir sur La Boîte à Bivouac.
			</p>
		</div>
	</section>

	<section class="border-b border-ardoise/30 bg-ecru-50 px-6 py-12">
		<div class="w-full">
			<h2 class="font-display text-xl font-semibold text-brun-600">Vous ne trouvez pas votre réponse ?</h2>
			<p class="mt-2 text-brun-500">Posez votre question ici, nous y répondrons prochainement.</p>

			<form id="ask-question-form" class="relative mt-6" method="post" novalidate>
				<label for="visitor-question" class="sr-only">Votre question</label>
				<textarea
					id="visitor-question"
					name="question"
					rows="3"
					required
					maxlength="1000"
					placeholder="Écrivez votre question ici…"
					class="w-full rounded-lg border border-ardoise/40 bg-ecru-50 px-4 py-2.5 text-brun-700 focus:border-rouille-400 focus:outline-none focus:ring-2 focus:ring-rouille-400/30"
				></textarea>

				<!-- Honeypot : caché visuellement (hors écran, pas display:none) pour piéger les bots sans gêner les lecteurs d'écran, qui l'ignorent grâce à aria-hidden/tabindex. -->
				<div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
					<label for="ask-question-website">Laissez ce champ vide</label>
					<input id="ask-question-website" name="website" type="text" tabindex="-1" autocomplete="off" />
				</div>

				<div id="ask-question-status" role="status" aria-live="polite" class="mt-3 hidden text-sm"></div>

				<button
					type="submit"
					class="mt-4 rounded-full bg-rouille-500 px-6 py-3 text-sm font-semibold text-ecru-50 shadow-sm transition-colors hover:bg-rouille-400 disabled:cursor-not-allowed disabled:opacity-60"
				>
					Envoyer ma question
				</button>
			</form>
		</div>
	</section>

	<section class="bg-ecru-100 px-6 pb-20">
		<div class="w-full">
			<p id="faq-status" class="text-brun-500">Chargement des questions…</p>
			<div id="faq-list" class="hidden divide-y divide-ardoise/30 border-t border-b border-ardoise/30"></div>
		</div>
	</section>
</Layout>

<script>
	interface FaqItem {
		question: string;
		answer: string;
	}

	async function fetchJson(url: string): Promise<unknown> {
		const response = await fetch(url, { cache: "no-store" });
		if (!response.ok) throw new Error(`${url} → ${response.status}`);
		return response.json();
	}

	function buildFaqItem(item: FaqItem, index: number): HTMLDivElement {
		const wrapper = document.createElement("div");
		wrapper.className = "faq-item";

		const heading = document.createElement("h2");
		const button = document.createElement("button");
		button.type = "button";
		button.className = "faq-question flex w-full items-center justify-between gap-4 py-5 text-left";
		button.setAttribute("aria-expanded", "false");
		button.setAttribute("aria-controls", `faq-answer-${index}`);
		button.id = `faq-question-${index}`;

		const questionSpan = document.createElement("span");
		questionSpan.className = "font-sans text-base font-semibold text-brun-600 sm:text-lg";
		questionSpan.textContent = item.question;

		const chevron = document.createElement("span");
		chevron.className =
			"faq-chevron shrink-0 text-lg text-brun-600 transition-transform duration-300 ease-in-out";
		chevron.setAttribute("aria-hidden", "true");
		chevron.textContent = "▾";

		button.append(questionSpan, chevron);
		heading.append(button);

		const answer = document.createElement("div");
		answer.id = `faq-answer-${index}`;
		answer.setAttribute("role", "region");
		answer.setAttribute("aria-labelledby", `faq-question-${index}`);
		answer.className = "faq-answer max-h-0 overflow-hidden transition-[max-height] duration-300 ease-in-out";

		const answerText = document.createElement("p");
		answerText.className = "pb-5 font-sans text-brun-500";
		answerText.textContent = item.answer;
		answer.append(answerText);

		wrapper.append(heading, answer);

		button.addEventListener("click", () => {
			const isOpen = button.getAttribute("aria-expanded") === "true";
			const nextOpen = !isOpen;

			button.setAttribute("aria-expanded", String(nextOpen));
			chevron.classList.toggle("rotate-180", nextOpen);
			answer.style.maxHeight = nextOpen ? `${answer.scrollHeight}px` : "0px";
		});

		return wrapper;
	}

	async function loadFaq() {
		const status = document.getElementById("faq-status");
		const list = document.getElementById("faq-list");
		if (!(status instanceof HTMLElement) || !(list instanceof HTMLElement)) return;

		let items: unknown;
		try {
			items = await fetchJson("/data/faq.json");
		} catch {
			items = null;
		}

		if (!Array.isArray(items)) {
			try {
				items = await fetchJson("/data/faq.default.json");
			} catch {
				items = [];
			}
		}

		if (!Array.isArray(items) || items.length === 0) {
			status.textContent = "Aucune question disponible pour le moment.";
			return;
		}

		items.forEach((item: FaqItem, index: number) => {
			list.append(buildFaqItem(item, index));
		});

		status.classList.add("hidden");
		list.classList.remove("hidden");
	}

	loadFaq();
</script>

<script>
	const askForm = document.getElementById("ask-question-form") as HTMLFormElement | null;
	const askStatus = document.getElementById("ask-question-status");
	const askSubmitButton = askForm?.querySelector<HTMLButtonElement>('button[type="submit"]');

	function showAskStatus(message: string, variant: "success" | "error") {
		if (!askStatus) return;
		askStatus.textContent = message;
		askStatus.classList.remove("hidden", "text-green-700", "text-red-700");
		askStatus.classList.add(variant === "success" ? "text-green-700" : "text-red-700");
	}

	askForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!askForm || !askSubmitButton) return;

		askSubmitButton.disabled = true;
		askSubmitButton.textContent = "Envoi en cours…";

		try {
			const response = await fetch("/ask-question.php", {
				method: "POST",
				body: new FormData(askForm),
				headers: { Accept: "application/json" },
			});

			let data: { success?: boolean; error?: string } = {};
			try {
				data = await response.json();
			} catch {
				// réponse non-JSON, on retombe sur le statut HTTP
			}

			if (response.ok && data.success) {
				showAskStatus("Merci, votre question a bien été envoyée !", "success");
				askForm.reset();
			} else {
				showAskStatus(
					data.error ?? "Une erreur est survenue lors de l'envoi. Merci de réessayer.",
					"error",
				);
			}
		} catch {
			showAskStatus(
				"Impossible de contacter le serveur. Vérifiez votre connexion et réessayez.",
				"error",
			);
		} finally {
			askSubmitButton.disabled = false;
			askSubmitButton.textContent = "Envoyer ma question";
		}
	});
</script>
