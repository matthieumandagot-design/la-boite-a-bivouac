---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { SOCIAL_LINKS } from "../consts";

const CONCEPT_POINTS = [
	{
		icon: "tabler:tent",
		title: "Sur le dessus",
		text: "Barres de toit intégrées.",
	},
	{
		icon: "tabler:box",
		title: "À l'intérieur",
		text: "Espace fermé et verrouillé.",
	},
	{
		icon: "tabler:puzzle",
		title: "Amovible",
		text: "La boîte se retire, la remorque redevient une remorque.",
	},
];

const GALLERY_IMAGES = [
	{ src: "/images/galerie-caisse-1.jpeg", alt: "La Boîte à Bivouac — caisse en cours de fabrication" },
	{ src: "/images/galerie-caisse-2.jpeg", alt: "La Boîte à Bivouac — caisse ouverte, portes dépliées" },
	{ src: "/images/galerie-remorque-1.jpeg", alt: "La Boîte à Bivouac montée sur sa remorque" },
	{ src: "/images/galerie-remorque-velos.jpeg", alt: "La Boîte à Bivouac, portes ouvertes avec des vélos à l'intérieur" },
	{ src: "/images/galerie-remorque-2.jpeg", alt: "La Boîte à Bivouac sur sa remorque, vue de face" },
	{ src: "/images/galerie-tente-1.jpeg", alt: "La Boîte à Bivouac avec la tente de toit déployée" },
	{ src: "/images/galerie-remorque-3.jpeg", alt: "La Boîte à Bivouac avec la housse de la tente de toit" },
	{ src: "/images/galerie-remorque-4.jpeg", alt: "La Boîte à Bivouac en situation, à l'arrêt" },
	{ src: "/images/galerie-tente-2.jpeg", alt: "La Boîte à Bivouac, tente de toit déployée avec l'échelle" },
];
---

<Layout
	title="La Boîte"
	description="La Boîte à Bivouac : une caisse amovible en acier et bois qui transforme votre remorque standard en base d'aventure, sans condamner son usage classique."
>
	<h1 class="sr-only">La Boîte à Bivouac — Votre base, partout</h1>

	<section class="relative flex min-h-[560px] items-center overflow-hidden bg-graphite text-ecru-50">
		<img
			src="/images/produit-remorque.jpeg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-graphite/90 via-graphite/70 to-graphite/40"></div>
		<div class="relative mx-auto grid max-w-5xl gap-10 px-6 py-20 lg:grid-cols-2 lg:items-center">
			<div>
				<h2 class="font-display text-3xl font-semibold sm:text-4xl">Le concept</h2>
				<p class="mt-4 text-ecru-100/90">
					La Boîte à Bivouac, c'est une caisse modulaire en acier et bois qui vient s'installer dans
					une remorque utilitaire standard. Sur le dessus, une tente de toit. À l'intérieur, de la
					place pour transporter ce qui compte&nbsp;: vélos, matériel de camping, équipement outdoor.
				</p>
				<p class="mt-4 text-ecru-100/90">
					Aucune modification de la remorque. Aucun usage condamné. La semaine, c'est une remorque.
					Le week-end, c'est une base.
				</p>
			</div>
			<div class="rounded-2xl border border-ecru-50/15 bg-graphite/55 p-8 shadow-sm backdrop-blur-md">
				<p class="text-xs font-medium uppercase tracking-widest text-mousse">L'essentiel</p>
				<ul class="mt-6 space-y-5">
					{
						CONCEPT_POINTS.map((point) => (
							<li class="flex items-center gap-4">
								<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-mousse text-sable">
									<Icon name={point.icon} class="h-6 w-6" />
								</span>
								<div>
									<p class="font-display text-base font-semibold">{point.title}</p>
									<p class="text-sm text-ecru-100/75">{point.text}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="bg-ecru-100 px-6 py-20">
		<div class="mx-auto max-w-5xl">
			<h2 class="font-display text-2xl font-semibold text-brun-700 sm:text-3xl">
				Fabriquée à la main, en Occitanie.
			</h2>
			<p class="mt-4 max-w-2xl text-brun-500">
				Le châssis est entièrement soudé à la main. Tubes acier, panneaux OSB, charnières robustes.
				Un produit conçu pour durer et pour être réparable.
			</p>
			<div class="mt-10 grid gap-6 sm:grid-cols-2">
				<img
					src="/images/fabrication-chassis.jpeg"
					alt="Châssis acier soudé"
					loading="lazy"
					class="aspect-[4/3] w-full rounded-2xl object-cover shadow-sm"
				/>
				<img
					src="/images/fabrication-garage.jpeg"
					alt="Caisse finalisée"
					loading="lazy"
					class="aspect-[4/3] w-full rounded-2xl object-cover shadow-sm"
				/>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-6 py-20">
		<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
			<img
				src="/images/produit-tente.jpeg"
				alt="La Boîte à Bivouac, prototype V1"
				loading="lazy"
				class="aspect-[4/3] w-full rounded-2xl object-cover shadow-sm"
			/>
			<div>
				<span class="inline-block rounded-full bg-mousse px-4 py-1 text-xs font-medium uppercase tracking-widest text-brun-700">
					Testée · En conditions réelles
				</span>
				<h2 class="mt-4 font-display text-2xl font-semibold text-brun-700 sm:text-3xl">
					V1 — Le prototype validé
				</h2>
				<p class="mt-4 text-brun-500">
					La V1 a roulé, bivouaqué et été testée pendant des semaines. Elle a validé le concept
					: la caisse tient sur la remorque, la tente de toit fonctionne, les vélos rentrent. Les
					apprentissages de ces essais alimentent directement la suite.
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-ardoise/30 bg-sable/50 px-6 py-20">
		<div class="mx-auto max-w-5xl">
			<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
				<div class="lg:order-2">
					<div class="flex aspect-[4/3] w-full items-center justify-center rounded-2xl bg-graphite p-12 shadow-sm">
						<img
							src="/images/logo-badge.png"
							alt="Logo La Boîte à Bivouac"
							loading="lazy"
							class="h-auto w-full max-w-[220px] object-contain"
						/>
					</div>
				</div>
				<div class="lg:order-1">
					<span class="inline-block rounded-full bg-rouille-500 px-4 py-1 text-xs font-medium uppercase tracking-widest text-ecru-50">
						Septembre 2026
					</span>
					<h2 class="mt-4 font-display text-2xl font-semibold text-brun-700 sm:text-3xl">
						V2 — Ce qui arrive en septembre
					</h2>
					<p class="mt-4 text-brun-500">
						La V2 intègre les retours des tests terrain. Plus légère, plus aérodynamique, avec un
						vrai système de fixation à la remorque conçu pour être installé et retiré en moins de
						10 minutes. Elle sera disponible en pré-commande à l'automne.
					</p>
					<a
						href="/contact"
						class="mt-6 inline-flex items-center gap-2 rounded-full bg-rouille-500 px-6 py-3 text-sm font-semibold text-ecru-50 shadow-sm transition-colors hover:bg-rouille-400"
					>
						Nous contacter
						<Icon name="tabler:arrow-right" class="h-4 w-4" />
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="border-t border-ardoise/30 px-6 py-16">
		<div class="mx-auto max-w-4xl">
			<h2 class="font-display text-2xl font-semibold text-brun-700">En images</h2>
			<div class="mt-8 grid grid-cols-3 gap-4">
				{
					GALLERY_IMAGES.map((img) => (
						<img
							src={img.src}
							alt={img.alt}
							loading="lazy"
							class="aspect-square w-full rounded-xl object-cover shadow-sm"
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-graphite px-6 py-20">
		<div class="mx-auto max-w-4xl">
			<h2 class="font-display text-2xl font-semibold text-ecru-50 sm:text-3xl">Nous suivre</h2>
			<ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					SOCIAL_LINKS.map((social) => (
						<li>
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								class="group flex items-center gap-4 rounded-xl border border-ardoise/30 bg-ecru-50 px-5 py-4 transition-all hover:-translate-y-0.5 hover:border-rouille-500 hover:bg-rouille-500 hover:shadow-md"
							>
								<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-mousse text-sable transition-colors group-hover:bg-ecru-50 group-hover:text-rouille-500">
									<Icon name={social.icon} class="h-6 w-6" />
								</span>
								<span class="font-display text-base font-semibold text-brun-700 transition-colors group-hover:text-ecru-50">
									{social.label}
								</span>
								<Icon
									name="tabler:arrow-up-right"
									class="ml-auto h-5 w-5 text-brun-400 transition-colors group-hover:text-ecru-50"
								/>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
