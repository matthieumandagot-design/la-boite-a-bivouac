---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { SITE_TITLE, SOCIAL_LINKS } from "../consts";
import SubscribeForm from "../components/SubscribeForm.astro";
import BivouacExplorer from "../components/BivouacExplorer.astro";
import VideoYouTube from "../components/VideoYouTube.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import Lightbox from "../components/Lightbox.astro";
import pine from "../components/icons/pine.svg?raw";
import bike from "../components/icons/bike.svg?raw";
import canoe from "../components/icons/canoe.svg?raw";
import { toJsonLd } from "../utils/jsonld";

const PAGE_DESCRIPTION =
	"La Boîte à Bivouac : caisse modulaire en acier et OSB qui s'installe dans votre remorque standard. Tente de toit, vélos, matériel. V2 en septembre 2026.";

// Les six points clés du produit, rendus en blocs identiques. Trois s'appuient
// sur une icône Tabler (`icon`), trois sur nos pictogrammes maison inlinés
// (`svg`) : le gabarit choisit le rendu selon le champ renseigné.
const ESSENTIALS = [
	{
		icon: "tabler:tent",
		title: "Sur le dessus",
		text: "Barres de toit intégrées.",
	},
	{
		icon: "tabler:box",
		title: "À l'intérieur",
		text: "Espace fermé et verrouillé.",
	},
	{
		icon: "tabler:puzzle",
		title: "Amovible",
		text: "La boîte se retire, la remorque redevient une remorque.",
	},
	{
		svg: pine,
		title: "Bivouac",
		text: "Forêt, montagne, bord de lac. Installez la tente de toit, ouvrez les portes, posez le camp. La Boîte à Bivouac fait de n'importe quel endroit votre base.",
	},
	{
		svg: bike,
		title: "Partez à 5.",
		text: "La tente de toit sur la Boîte accueille 3 personnes ou plus. Le véhicule, libéré du matériel, en loge 2 supplémentaires. L'aventure n'est plus réservée aux duos.",
	},
	{
		svg: canoe,
		title: "Côte & campings",
		text: "Base fixe, exploration mobile. La Boîte à Bivouac devient votre quartier général — vous repartez visiter la région avec un véhicule agile, sans compromis.",
	},
];

const GALLERY_IMAGES = [
	{ src: "/images/galerie-caisse-1.jpeg", alt: "La Boîte à Bivouac — caisse en cours de fabrication" },
	{ src: "/images/galerie-caisse-2.jpeg", alt: "La Boîte à Bivouac — caisse ouverte, portes dépliées" },
	{ src: "/images/galerie-remorque-2.jpeg", alt: "La Boîte à Bivouac sur sa remorque, vue de face" },
	{ src: "/images/galerie-tente-1.jpeg", alt: "La Boîte à Bivouac avec la tente de toit déployée" },
	{ src: "/images/galerie-remorque-3.jpeg", alt: "La Boîte à Bivouac avec la housse de la tente de toit" },
	{ src: "/images/galerie-tente-2.jpeg", alt: "La Boîte à Bivouac, tente de toit déployée avec l'échelle" },
];

// Images produit réellement présentes sur cette page (hors logo/illustrations
// de marque) : hero, photos de fabrication, prototype V1, galerie.
const PRODUCT_IMAGE_PATHS = [
	"/images/produit-remorque.jpeg",
	"/images/fabrication-chassis.jpeg",
	"/images/fabrication-garage.jpeg",
	"/images/produit-tente.jpeg",
	...GALLERY_IMAGES.map((img) => img.src),
];

const productSchema = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: SITE_TITLE,
	description: PAGE_DESCRIPTION,
	image: PRODUCT_IMAGE_PATHS.map((path) => new URL(path, Astro.site).href),
	brand: {
		"@type": "Organization",
		name: SITE_TITLE,
	},
	offers: {
		"@type": "Offer",
		// Prix indicatif, cf. l'astérisque "Prix de vente indicatif, susceptible
		// de varier selon la configuration et les options choisies." affiché sur
		// la section prix du site (voir src/pages/index.astro).
		price: "2000",
		priceCurrency: "EUR",
		availability: "https://schema.org/PreOrder",
		url: "https://laboiteabivouac.fr/la-boite",
	},
};
---

<Layout title="La Boîte" description={PAGE_DESCRIPTION}>
	<script type="application/ld+json" set:html={toJsonLd(productSchema)} />

	<h1 class="sr-only">La Boîte à Bivouac — Votre base, partout</h1>
	<ScrollReveal />
	<Lightbox />

	<section class="relative flex min-h-[560px] items-center overflow-hidden bg-graphite text-ecru-50">
		<img
			src="/images/produit-remorque.jpeg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-graphite/95 via-graphite/80 to-graphite/65"></div>
		<div
			class="relative mx-auto grid w-full max-w-6xl gap-10 px-6 py-20 lg:grid-cols-2 lg:items-center lg:gap-14"
		>
			<div data-reveal="left">
				<h2 class="font-display text-3xl font-semibold sm:text-4xl">Le concept</h2>
				<p class="mt-4 text-ecru-100/90">
					La Boîte à Bivouac, c'est une caisse modulaire en acier et bois qui vient s'installer dans
					une remorque utilitaire standard. Sur le dessus, une tente de toit. À l'intérieur, de la
					place pour transporter ce qui compte&nbsp;: vélos, matériel de camping, équipement outdoor.
				</p>
				<p class="mt-4 text-ecru-100/90">
					Aucune modification de la remorque. Aucun usage condamné. La semaine, c'est une remorque.
					Le week-end, c'est une base.
				</p>
			</div>
			<figure class="m-0" data-reveal="right" style="--reveal-delay: 140ms">
				<VideoYouTube
					id="KX_vy58MSrA"
					titre="La Boîte à Bivouac : installation complète du camp en quelques minutes"
					poster="/images/video-presentation.jpg"
				/>
				<figcaption class="mt-4 text-sm text-ecru-100/75">
					<span class="font-display font-semibold text-ecru-50">
						Le camp installé en quelques minutes.
					</span>{" "}
					Déplier la tente, ouvrir les panneaux, sortir le matériel&nbsp;: une installation complète,
					sans montage compliqué ni outil à sortir.
				</figcaption>
			</figure>
		</div>
	</section>

	<section class="bg-ecru-100 px-6 py-20">
		<div class="mx-auto max-w-5xl">
			<h2 class="text-xs font-medium uppercase tracking-widest text-rouille-500" data-reveal>
				L'essentiel
			</h2>
			{/* auto-rows-fr : les six blocs gardent la même hauteur malgré des
			    textes de longueurs très différentes. Seulement à partir de sm,
			    car en colonne unique cela ne ferait qu'ajouter du vide. */}
			<ul class="mt-8 grid gap-6 sm:auto-rows-fr sm:grid-cols-2 lg:grid-cols-3">
				{
					ESSENTIALS.map((item, index) => (
						<li
							class="flex flex-col rounded-2xl border border-ardoise/30 bg-ecru-50 p-6 shadow-sm"
							data-reveal
							style={`--reveal-delay: ${index * 70}ms`}
						>
							<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-mousse text-sable">
								{
									item.svg ? (
										<span class="h-6 w-6 [&>svg]:h-full [&>svg]:w-full" set:html={item.svg} />
									) : (
										<Icon name={item.icon} class="h-6 w-6" />
									)
								}
							</span>
							<h3 class="mt-5 font-display text-lg font-semibold text-brun-700">{item.title}</h3>
							<p class="mt-2 text-sm text-brun-500">{item.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<BivouacExplorer />

	<section id="apres-exploration" class="scroll-mt-24 bg-ecru-100 px-6 py-20">
		<div class="mx-auto max-w-5xl">
			<h2 class="font-display text-2xl font-semibold text-brun-700 sm:text-3xl" data-reveal>
				Fabriquée à la main, en Occitanie.
			</h2>
			<p class="mt-4 max-w-2xl text-brun-500" data-reveal style="--reveal-delay: 90ms">
				Le châssis est entièrement soudé à la main. Tubes acier, panneaux OSB, charnières robustes.
				Un produit conçu pour durer et pour être réparable.
			</p>
			<div class="mt-10 grid gap-6 sm:grid-cols-2">
				<button
					type="button"
					class="lightbox-trigger aspect-[4/3] w-full overflow-hidden rounded-2xl shadow-sm"
					data-lightbox="fabrication"
					data-reveal
					style="--reveal-delay: 180ms"
				>
					<img
						src="/images/fabrication-chassis.jpeg"
						alt="Châssis acier soudé"
						loading="lazy"
						class="h-full w-full object-cover"
					/>
				</button>
				<button
					type="button"
					class="lightbox-trigger aspect-[4/3] w-full overflow-hidden rounded-2xl shadow-sm"
					data-lightbox="fabrication"
					data-reveal
					style="--reveal-delay: 240ms"
				>
					<img
						src="/images/fabrication-garage.jpeg"
						alt="Caisse finalisée"
						loading="lazy"
						class="h-full w-full object-cover"
					/>
				</button>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-6 py-20">
		<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
			<button
				type="button"
				class="lightbox-trigger aspect-[4/3] w-full overflow-hidden rounded-2xl shadow-sm"
				data-lightbox="prototype"
				data-reveal="left"
			>
				<img
					src="/images/produit-tente.jpeg"
					alt="La Boîte à Bivouac, prototype V1"
					loading="lazy"
					class="h-full w-full object-cover"
				/>
			</button>
			<div data-reveal="right" style="--reveal-delay: 120ms">
				<span class="inline-block rounded-full bg-mousse px-4 py-1 text-xs font-medium uppercase tracking-widest text-brun-700">
					Testée · En conditions réelles
				</span>
				<h2 class="mt-4 font-display text-2xl font-semibold text-brun-700 sm:text-3xl">
					V1 — Le prototype validé
				</h2>
				<p class="mt-4 text-brun-500">
					La V1 a roulé, bivouaqué et été testée pendant des semaines. Elle a validé le concept
					: la caisse tient sur la remorque, la tente de toit fonctionne, les vélos rentrent. Les
					apprentissages de ces essais alimentent directement la suite.
				</p>
			</div>
		</div>

		<h3 class="mt-16 font-display text-xl font-semibold text-brun-700" data-reveal>En images</h3>
		<div class="mt-6 grid grid-cols-3 gap-4">
			{
				GALLERY_IMAGES.map((img, index) => (
					<button
						type="button"
						class="lightbox-trigger aspect-square w-full overflow-hidden rounded-xl shadow-sm"
						data-lightbox="galerie"
						data-reveal
						style={`--reveal-delay: ${index * 60}ms`}
					>
						<img src={img.src} alt={img.alt} loading="lazy" class="h-full w-full object-cover" />
					</button>
				))
			}
		</div>
	</section>

	<section class="border-t border-ardoise/30 bg-sable/50 px-6 py-20">
		<div class="mx-auto max-w-5xl">
			<div class="grid gap-10 lg:grid-cols-2 lg:items-center">
				<div class="lg:order-2" data-reveal="right">
					<div class="flex aspect-[4/3] w-full items-center justify-center rounded-2xl bg-graphite p-12 shadow-sm">
						<img
							src="/images/logo-badge.png"
							alt="Logo La Boîte à Bivouac"
							loading="lazy"
							class="h-auto w-full max-w-[220px] object-contain"
						/>
					</div>
				</div>
				<div class="lg:order-1" data-reveal="left" style="--reveal-delay: 120ms">
					<span class="inline-block rounded-full bg-rouille-500 px-4 py-1 text-xs font-medium uppercase tracking-widest text-ecru-50">
						Septembre 2026
					</span>
					<h2 class="mt-4 font-display text-2xl font-semibold text-brun-700 sm:text-3xl">
						V2 — Ce qui arrive en septembre
					</h2>
					<p class="mt-4 text-brun-500">
						La V2 intègre les retours des tests terrain. Plus légère, plus aérodynamique, avec un
						vrai système de fixation à la remorque conçu pour être installé et retiré en moins de
						10 minutes. Elle sera disponible en pré-commande à l'automne.
					</p>
					<div class="mt-6">
						<p class="text-sm font-semibold text-brun-700">Restez informé</p>
						<p class="mt-1 text-xs text-brun-400">Recevez un email dès que la V2 est disponible.</p>
						<div class="mt-3">
							<SubscribeForm />
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="border-t border-ardoise/30 bg-ecru-50 px-6 py-20 text-center">
		<div class="mx-auto max-w-2xl">
			<h2 class="text-xs font-medium uppercase tracking-widest text-rouille-500" data-reveal>
				Le juste prix
			</h2>
			<p
				class="mt-4 font-display text-2xl font-semibold text-brun-700 sm:text-3xl"
				data-reveal
				style="--reveal-delay: 90ms"
			>
				2&nbsp;000&nbsp;€.
			</p>
			<p class="mt-4 text-brun-500" data-reveal style="--reveal-delay: 180ms">
				Nous voulons que partir à quatre ou cinq reste accessible. C'est ce qui guide nos
				choix&nbsp;: des matériaux simples, un assemblage que nous maîtrisons, et le prix le plus
				bas que nous puissions tenir sans rogner sur la solidité.
			</p>
			<p class="mt-6 text-sm text-brun-400" data-reveal style="--reveal-delay: 240ms">
				*Prix de vente indicatif, susceptible de varier selon la configuration et les options
				choisies. Les équipements ne sont pas compris.
			</p>
		</div>
	</section>

	<section class="bg-graphite px-6 py-20">
		<div class="mx-auto max-w-4xl">
			<h2 class="font-display text-2xl font-semibold text-ecru-50 sm:text-3xl" data-reveal>
				Nous suivre
			</h2>
			<ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					SOCIAL_LINKS.map((social, index) => (
						<li data-reveal style={`--reveal-delay: ${index * 80}ms`}>
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								class="group flex items-center gap-4 rounded-xl border border-ardoise/30 bg-ecru-50 px-5 py-4 transition-all hover:-translate-y-0.5 hover:border-rouille-500 hover:bg-rouille-500 hover:shadow-md"
							>
								<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-mousse text-sable transition-colors group-hover:bg-ecru-50 group-hover:text-rouille-500">
									<Icon name={social.icon} class="h-6 w-6" />
								</span>
								<span class="font-display text-base font-semibold text-brun-700 transition-colors group-hover:text-ecru-50">
									{social.label}
								</span>
								<Icon
									name="tabler:arrow-up-right"
									class="ml-auto h-5 w-5 text-brun-400 transition-colors group-hover:text-ecru-50"
								/>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
