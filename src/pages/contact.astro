---
import Layout from "../layouts/Layout.astro";

const CONTACT_EMAIL = "contact@laboiteabivouac.fr";
---

<Layout title="Contact">
	<section class="border-b border-kaki-200 bg-kaki-100/50 px-6 py-16">
		<div class="mx-auto max-w-4xl">
			<p class="text-xs font-medium uppercase tracking-widest text-rouille-500">Contact</p>
			<h1 class="mt-3 font-display text-4xl font-semibold text-brun-700">Parlons de votre projet</h1>
			<p class="mt-6 max-w-2xl text-lg text-brun-500">
				Une question sur la compatibilité avec votre remorque, votre tente de toit ou votre VTT ?
				Écrivez-nous, on vous répond rapidement.
			</p>
		</div>
	</section>

	<section class="mx-auto grid max-w-4xl gap-12 px-6 py-16 lg:grid-cols-5">
		<div class="lg:col-span-2">
			<h2 class="font-display text-xl font-semibold text-brun-700">Coordonnées</h2>
			<dl class="mt-6 space-y-4 text-brun-500">
				<div>
					<dt class="text-sm font-medium text-brun-600">Email</dt>
					<dd>
						<a href={`mailto:${CONTACT_EMAIL}`} class="text-rouille-500 hover:underline">
							{CONTACT_EMAIL}
						</a>
					</dd>
				</div>
				<div>
					<dt class="text-sm font-medium text-brun-600">Zone</dt>
					<dd>France — expéditions et rendez-vous sur devis</dd>
				</div>
			</dl>
		</div>

		<form
			class="space-y-6 lg:col-span-3"
			method="post"
			action={`mailto:${CONTACT_EMAIL}`}
			enctype="text/plain"
		>
			<div>
				<label for="name" class="block text-sm font-medium text-brun-600">Nom</label>
				<input
					id="name"
					name="Nom"
					type="text"
					required
					class="mt-2 w-full rounded-lg border border-kaki-300 bg-ecru-50 px-4 py-2.5 text-brun-700 focus:border-rouille-400 focus:outline-none focus:ring-2 focus:ring-rouille-400/30"
				/>
			</div>
			<div>
				<label for="email" class="block text-sm font-medium text-brun-600">Email</label>
				<input
					id="email"
					name="Email"
					type="email"
					required
					class="mt-2 w-full rounded-lg border border-kaki-300 bg-ecru-50 px-4 py-2.5 text-brun-700 focus:border-rouille-400 focus:outline-none focus:ring-2 focus:ring-rouille-400/30"
				/>
			</div>
			<div>
				<label for="message" class="block text-sm font-medium text-brun-600">Message</label>
				<textarea
					id="message"
					name="Message"
					rows="5"
					required
					class="mt-2 w-full rounded-lg border border-kaki-300 bg-ecru-50 px-4 py-2.5 text-brun-700 focus:border-rouille-400 focus:outline-none focus:ring-2 focus:ring-rouille-400/30"
				></textarea>
			</div>
			<button
				type="submit"
				class="rounded-full bg-rouille-500 px-6 py-3 text-sm font-semibold text-ecru-50 shadow-sm transition-colors hover:bg-rouille-400"
			>
				Envoyer le message
			</button>
		</form>
	</section>
</Layout>
