---
interface Props {
	title: string;
}

const { title } = Astro.props;

/**
 * Compare deux chemins sans se soucier du slash final.
 *
 * Les href de NAV_ITEMS en portent un (« /admin/subscribers/ »), conformément à
 * la convention du site, alors que le chemin courant était comparé après
 * suppression du sien. Les deux ne pouvaient donc jamais être égaux, et aucun
 * lien n'était surligné — sur les trois pages Astro, le menu n'indiquait jamais
 * où l'on se trouvait. Normaliser les deux côtés est la seule façon d'éviter
 * que la comparaison dépende d'un détail d'écriture.
 */
const normaliseChemin = (chemin: string): string => chemin.replace(/\/+$/, "") || "/";
const currentPath = normaliseChemin(Astro.url.pathname);

const NAV_ITEMS = [
	{ href: "/admin/", label: "Tableau de bord", icon: "🏠" },
	{ href: "/admin/subscribers/", label: "Abonnés", icon: "📧" },
	{ href: "/admin/send-news/", label: "Envoyer une news", icon: "📨" },
	{ href: "/admin/equipements.php", label: "Équipements", icon: "🧰" },
	{ href: "/admin/faq.php", label: "FAQ", icon: "❓" },
	{ href: "/admin/produits.php", label: "Produits", icon: "📦" },
	{ href: "/admin/commandes.php", label: "Commandes", icon: "🧾" },
	{ href: "/admin/clients.php", label: "Clients", icon: "👥" },
	{ href: "/admin/parametres.php", label: "Paramètres", icon: "⚙️" },
	{ href: "/admin/base.php", label: "Base de données", icon: "🗄️" },
];

// Raccourcis vers les outils externes utilisés au quotidien : ouverts dans un
// nouvel onglet, ils ne font pas partie de la navigation du site lui-même.
const ADMIN_TOOL_LINKS = [
	{ href: "https://cloud.umami.is/analytics/eu/websites", label: "Umami", icon: "📊" },
	{
		href: "https://search.google.com/search-console?hl=fr&resource_id=https://laboiteabivouac.fr/",
		label: "Search Console",
		icon: "🔍",
	},
	{
		href: "https://www.google.com/search?q=La+Bo%C3%AEte+%C3%A0+Bivouac&stick=H4sIAAAAAAAA_-NgU1I1qEhMSkk1TDJONU4zMDYyszS1MqgwMjW1TLY0TjQ2T05OSzYyWMQq4pOo4JR_eF1JqsLhBQpOmWX5pYnJAE6QNhdAAAAA&hl=fr&mat=CZ21dska8KCrElYBa0lj_zMH55jHjvES16LWm6uTi6l3nowGSeXXeYK8C2mZEzADs4zLYTBuJTBDpu9rjVR4AstE7uSgyyshKQxIZew91anM46AH6SPo0ADhovME3I66iQ&authuser=0&ved=2ahUKEwiQt9va1-yWAxUR5AIHHRojKggQ-MgIegQIFxAb",
		label: "Fiche Google",
		icon: "📍",
	},
	{ href: "https://app.brevo.com/", label: "Brevo", icon: "📧" },
	// Mode test — voir la note dans public/admin/nav.php avant de passer en réel.
	{ href: "https://dashboard.stripe.com/acct_1UJZzZ1YjormFH5b/test/dashboard", label: "Stripe", icon: "💳" },
	{ href: "https://manager.eu.ovhcloud.com/", label: "OVH Manager", icon: "☁️" },
	{
		href: "https://app.notion.com/p/La-Bo-te-Bivouac-Pilotage-3ac440dc05e5811a891fe579c98c9c56",
		label: "Notion",
		icon: "📓",
	},
	{ href: "https://zimbra1.mail.ovh.net/modern/email/Inbox/conversation/-258", label: "Webmail OVH", icon: "✉️" },
	{ href: "https://calendar.google.com/calendar/u/0/r?pli=1", label: "Google Agenda", icon: "📅" },
	{ href: "https://mail.google.com/mail/u/0/#inbox", label: "Gmail", icon: "📬" },
];

const SOCIAL_TOOL_LINKS = [
	{ href: "https://www.tiktok.com/@laboiteabivouac8", label: "TikTok", icon: "🎵" },
	{ href: "https://www.youtube.com/@LaBo%C3%AEte%C3%A0Bivouac", label: "YouTube", icon: "▶️" },
	{ href: "https://www.linkedin.com/company/136036436/admin/dashboard/", label: "LinkedIn", icon: "💼" },
	{ href: "https://www.facebook.com/laboiteabivouac?checkpoint_src=any", label: "Facebook", icon: "👍" },
	{ href: "https://www.instagram.com/laboiteabivouac/", label: "Instagram", icon: "📷" },
	{ href: "https://www.threads.com/@laboiteabivouac", label: "Threads", icon: "🧵" },
	{ href: "https://fr.pinterest.com/laboiteabivouac/", label: "Pinterest", icon: "📌" },
];
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="google-site-verification" content="avkBfLGhoafCr2aNMCglt3Elo1Hz6shb3pbemZ8D7Kg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} — Administration · La Boîte à Bivouac</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<style>
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font-family: "Inter", system-ui, sans-serif;
				background: #f4f2ee;
			}
			a {
				color: inherit;
			}
		</style>
	</head>
	<body>
		{/* Les deux écrans partent masqués. Le script en ligne plus bas décide
		    lequel afficher avant le premier rendu : autrement, le navigateur
		    peignait l'écran de connexion sombre à chaque changement de page,
		    puis le remplaçait par l'application une fois le réseau revenu. */}
		<div
			id="admin-login-gate"
			style="min-height:100vh;display:none;align-items:center;justify-content:center;background:#122218;padding:1.5rem;"
		>
			<form
				id="admin-login-form"
				style="width:100%;max-width:360px;background:#fdfaf2;border-radius:1rem;padding:2rem;box-shadow:0 8px 28px rgba(18,34,24,0.35);"
			>
				<p style="text-transform:uppercase;letter-spacing:.08em;font-size:.7rem;font-weight:700;color:#b88a18;margin:0 0 .35rem;">
					La Boîte à Bivouac
				</p>
				<h1 style="font-size:1.35rem;font-weight:700;margin:0 0 1.5rem;color:#122218;">Administration</h1>

				<label style="display:block;font-weight:600;font-size:.85rem;margin-bottom:.35rem;color:#122218;">
					Identifiant
				</label>
				<input
					id="admin-username"
					type="text"
					autocomplete="username"
					required
					style="width:100%;padding:.65rem .75rem;margin-bottom:1rem;border:1px solid #c0c8c8;border-radius:.5rem;font-size:1rem;"
				/>

				<label style="display:block;font-weight:600;font-size:.85rem;margin-bottom:.35rem;color:#122218;">
					Mot de passe
				</label>
				<input
					id="admin-password"
					type="password"
					autocomplete="current-password"
					required
					style="width:100%;padding:.65rem .75rem;margin-bottom:1.25rem;border:1px solid #c0c8c8;border-radius:.5rem;font-size:1rem;"
				/>

				<p id="admin-login-error" style="display:none;color:#8b1c1c;font-size:.85rem;margin:0 0 1rem;"></p>

				<button
					type="submit"
					style="width:100%;background:#e8b428;color:#0a1610;border:none;border-radius:9999px;padding:.75rem;font-weight:700;font-size:.95rem;cursor:pointer;"
				>
					Se connecter
				</button>
			</form>
		</div>

		<div id="admin-shell" style="display:none;min-height:100vh;">
			<aside
				style="width:220px;flex-shrink:0;background:#122218;color:#e8e0c8;display:flex;flex-direction:column;position:fixed;top:0;bottom:0;left:0;"
			>
				<div style="padding:1.5rem 1.25rem;border-bottom:1px solid rgba(232,224,200,0.12);">
					<p style="text-transform:uppercase;letter-spacing:.08em;font-size:.65rem;font-weight:700;color:#e8b428;margin:0 0 .2rem;">
						La Boîte à Bivouac
					</p>
					<p style="font-weight:700;font-size:1rem;margin:0;">Administration</p>
				</div>
				<nav style="flex:1;overflow-y:auto;padding:1rem 0.75rem;">
					{
						NAV_ITEMS.map((item) => {
							const active = normaliseChemin(item.href) === currentPath;
							return (
								<a
									href={item.href}
									aria-current={active ? "page" : undefined}
									style={`display:flex;align-items:center;gap:.6rem;padding:.65rem .75rem;border-radius:.5rem;margin-bottom:.25rem;text-decoration:none;font-size:.9rem;font-weight:500;color:${active ? "#0a1610" : "#e8e0c8"};background:${active ? "#e8b428" : "transparent"};`}
								>
									<span aria-hidden="true">{item.icon}</span>
									{item.label}
								</a>
							);
						})
					}
					<a
						href="/"
						target="_blank"
						rel="noopener"
						style="display:flex;align-items:center;gap:.6rem;padding:.65rem .75rem;border-radius:.5rem;margin-top:.75rem;text-decoration:none;font-size:.9rem;font-weight:500;color:#babba8;border-top:1px solid rgba(232,224,200,0.12);padding-top:1rem;"
					>
						<span aria-hidden="true">🌐</span>
						Voir le site
					</a>

					<p style="text-transform:uppercase;letter-spacing:.1em;font-size:.65rem;font-weight:700;color:#7f8a77;margin:1.25rem 0 .35rem;padding:0 .75rem;">
						Admin
					</p>
					{
						ADMIN_TOOL_LINKS.map((link) => (
							<a
								href={link.href}
								target="_blank"
								rel="noopener"
								style="display:flex;align-items:center;gap:.6rem;padding:.45rem .75rem;border-radius:.5rem;text-decoration:none;font-size:.82rem;font-weight:500;color:#babba8;"
							>
								<span aria-hidden="true">{link.icon}</span>
								{link.label}
							</a>
						))
					}

					<p style="text-transform:uppercase;letter-spacing:.1em;font-size:.65rem;font-weight:700;color:#7f8a77;margin:1.25rem 0 .35rem;padding:0 .75rem;">
						Réseaux
					</p>
					{
						SOCIAL_TOOL_LINKS.map((link) => (
							<a
								href={link.href}
								target="_blank"
								rel="noopener"
								style="display:flex;align-items:center;gap:.6rem;padding:.45rem .75rem;border-radius:.5rem;text-decoration:none;font-size:.82rem;font-weight:500;color:#babba8;"
							>
								<span aria-hidden="true">{link.icon}</span>
								{link.label}
							</a>
						))
					}
				</nav>
				<div style="padding:1rem 1.25rem;border-top:1px solid rgba(232,224,200,0.12);">
					<button
						id="admin-logout"
						style="width:100%;background:transparent;border:1px solid rgba(232,224,200,0.3);color:#e8e0c8;border-radius:.5rem;padding:.5rem;font-size:.85rem;cursor:pointer;"
					>
						Déconnexion
					</button>
				</div>
			</aside>

			<div style="margin-left:220px;flex:1;display:flex;flex-direction:column;min-height:100vh;">
				<header
					style="background:#fff;border-bottom:1px solid #e4e0d8;padding:1rem 2rem;display:flex;align-items:center;justify-content:space-between;"
				>
					<h1 style="font-size:1.1rem;font-weight:700;color:#122218;margin:0;">{title}</h1>
				</header>
				<main style="flex:1;padding:2rem;">
					<slot />
				</main>
			</div>
		</div>

		<noscript>
			<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#122218;color:#e8e0c8;padding:1.5rem;text-align:center;font-family:'Inter',system-ui,sans-serif;">
				<p>L'administration a besoin de JavaScript pour fonctionner.</p>
			</div>
		</noscript>

		{/* En ligne et non bundlé : ces quelques lignes doivent s'exécuter avant
		    le premier rendu. Un script de module Astro est différé, il ne
		    s'exécute qu'après l'analyse du document — trop tard, l'écran a déjà
		    été peint. Même motif que les scripts de thème sombre.

		    La décision est purement locale (localStorage), donc instantanée :
		    aucun aller-retour réseau avant d'afficher quelque chose. La
		    vérification des identifiants, elle, continue en arrière-plan dans le
		    script ci-dessous, et referme l'application s'ils ne valent plus rien.

		    Révéler l'interface sans attendre ne divulgue rien : ce HTML est
		    public de toute façon, et toutes les données passent par adminFetch,
		    que le serveur n'honore qu'avec une session admin valide, et qui
		    retombe sur l'écran de connexion au moindre 401. */}
		<script is:inline>
			(function () {
				// Simple indice d'affichage, pas une preuve : la session réelle est
				// un cookie HttpOnly que ce script ne peut pas lire. Il évite
				// seulement de peindre l'écran de connexion à chaque changement de
				// page ; le script suivant vérifie auprès du serveur.
				var connecte = false;
				try {
					connecte =
						localStorage.getItem("lbb_admin_connecte") === "1" &&
						new URLSearchParams(location.search).get("deconnexion") !== "1";
				} catch (erreur) {
					// Stockage inaccessible : on montre l'écran de connexion.
				}
				var cible = document.getElementById(connecte ? "admin-shell" : "admin-login-gate");
				if (cible) {
					cible.style.display = "flex";
				}
			})();
		</script>

		<script>
			/*
			 * Connexion unique à l'administration (depuis le 27/09/2026).
			 *
			 * Le mot de passe part une seule fois, au formulaire, en Basic Auth :
			 * le serveur ouvre alors une session admin (cookie HttpOnly, 8 h), qui
			 * vaut pour ces pages, pour les pages PHP (Commandes, Produits, FAQ…)
			 * et pour le mode aperçu. Le mot de passe n'est plus conservé dans le
			 * navigateur.
			 *
			 * Les requêtes portent l'en-tête X-Admin-Requete : le serveur l'exige
			 * sur toute écriture authentifiée par session, et un autre site ne
			 * peut pas l'ajouter (protection CSRF, voir api/lib/admin-auth.php).
			 */
			const INDICE = "lbb_admin_connecte";

			function marquerConnecte(oui: boolean) {
				try {
					if (oui) localStorage.setItem(INDICE, "1");
					else localStorage.removeItem(INDICE);
				} catch {
					// Sans stockage, seul l'indice d'affichage est perdu.
				}
			}

			// Ancien stockage du mot de passe en clair (avant le 27/09/2026).
			try {
				sessionStorage.removeItem("lbb_admin_credentials");
			} catch {
				// Rien à nettoyer.
			}

			const loginGate = document.getElementById("admin-login-gate")!;
			const shell = document.getElementById("admin-shell")!;

			function showLoginGate() {
				loginGate.style.display = "flex";
				shell.style.display = "none";
			}

			function showShell() {
				loginGate.style.display = "none";
				shell.style.display = "flex";
			}

			async function adminFetch(url: string, options: RequestInit = {}): Promise<Response> {
				const headers = new Headers(options.headers);
				headers.set("X-Admin-Requete", "1");
				const response = await fetch(url, { ...options, headers, credentials: "same-origin" });
				if (response.status === 401) {
					marquerConnecte(false);
					showLoginGate();
				}
				return response;
			}

			// Exposé pour les scripts des pages admin (tableau de bord, abonnés, envoi de news).
			(window as any).adminFetch = adminFetch;

			/**
			 * Page PHP d'où vient l'administrateur, renvoyé ici faute de session.
			 * Seuls les chemins de /admin/ sont suivis : un paramètre retour
			 * pointant ailleurs ferait de ce formulaire un tremplin de phishing.
			 */
			function retourDemande(): string | null {
				const retour = new URLSearchParams(location.search).get("retour");
				return retour && retour.startsWith("/admin/") ? retour : null;
			}

			async function deconnecter() {
				try {
					await fetch("/api/admin-deconnexion.php", {
						method: "POST",
						headers: { "X-Admin-Requete": "1" },
						credentials: "same-origin",
					});
				} catch {
					// Hors-ligne : la session expirera d'elle-même.
				}
				marquerConnecte(false);
				history.replaceState(null, "", "/admin/");
				showLoginGate();
			}

			/**
			 * Vérifie la session auprès du serveur, puis affiche l'écran qui
			 * convient. L'événement admin-authenticated déclenche le chargement
			 * des données de chaque page.
			 */
			async function verifyAndReveal() {
				if (new URLSearchParams(location.search).get("deconnexion") === "1") {
					await deconnecter();
					return;
				}

				try {
					const response = await fetch("/api/subscribers.php", { credentials: "same-origin" });
					if (response.ok) {
						marquerConnecte(true);
						const retour = retourDemande();
						if (retour) {
							location.replace(retour);
							return;
						}
						showShell();
						window.dispatchEvent(new CustomEvent("admin-authenticated"));
					} else {
						marquerConnecte(false);
						showLoginGate();
					}
				} catch {
					// Hors-ligne : on garde l'écran affiché plutôt que de forcer
					// une reconnexion impossible à réussir sans réseau.
				}
			}

			const loginForm = document.getElementById("admin-login-form") as HTMLFormElement;
			const loginError = document.getElementById("admin-login-error")!;

			loginForm.addEventListener("submit", async (event) => {
				event.preventDefault();
				const username = (document.getElementById("admin-username") as HTMLInputElement).value;
				const password = (document.getElementById("admin-password") as HTMLInputElement).value;

				loginError.style.display = "none";

				try {
					// Seul envoi du mot de passe : le serveur ouvre la session admin.
					const response = await fetch("/api/subscribers.php", {
						headers: { Authorization: "Basic " + btoa(`${username}:${password}`) },
						credentials: "same-origin",
					});

					if (response.ok) {
						marquerConnecte(true);
						const retour = retourDemande();
						if (retour) {
							location.replace(retour);
							return;
						}
						showShell();
						window.dispatchEvent(new CustomEvent("admin-authenticated"));
					} else {
						loginError.textContent = "Identifiant ou mot de passe incorrect.";
						loginError.style.display = "block";
					}
				} catch {
					loginError.textContent = "Impossible de contacter le serveur.";
					loginError.style.display = "block";
				}
			});

			document.getElementById("admin-logout")?.addEventListener("click", () => {
				void deconnecter();
			});

			verifyAndReveal();
		</script>
	</body>
</html>
