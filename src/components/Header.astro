---
import { SITE_TITLE, NAV_LINKS } from "../consts";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
	if (href === "/") return currentPath === "/";
	return currentPath.startsWith(href);
}
---

<header class="border-b border-ardoise/30 bg-ecru-50/95 backdrop-blur sticky top-0 z-50">
	<div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
		<a href="/" class="flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-brun-600">
			<img src="/images/logo-badge.png" alt="" aria-hidden="true" class="h-12 w-auto object-contain" />
			{SITE_TITLE}
		</a>
		<nav aria-label="Navigation principale">
			<ul class="flex gap-1 text-sm">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? "page" : undefined}
								class:list={[
									"rounded-full px-4 py-2 transition-colors",
									isActive(link.href)
										? "bg-mousse text-sable"
										: "text-brun-600 hover:bg-sable",
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
