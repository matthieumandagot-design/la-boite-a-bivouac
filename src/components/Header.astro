---
import { Icon } from "astro-icon/components";
import { SITE_TITLE, NAV_LINKS, NAVBAR_SOCIAL_LINKS } from "../consts";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
	if (href === "/") return currentPath === "/";
	return currentPath.startsWith(href);
}

const socialIconPaths: Record<string, string> = {
	instagram:
		'<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
	facebook:
		'<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
	linkedin:
		'<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
};
---

<header class="border-b border-ardoise/30 bg-ecru-50/95 backdrop-blur sticky top-0 z-50">
	<div class="grid w-full grid-cols-[auto_1fr_auto] items-center gap-3 px-6 py-3 sm:py-4 md:grid-cols-[1fr_auto_1fr]">
		<a
			href="/"
			class="col-start-1 flex min-w-0 shrink items-center gap-2 justify-self-start font-display text-base font-semibold tracking-tight text-brun-600 sm:text-lg"
		>
			<img src="/images/logo-badge.png" alt="" aria-hidden="true" class="h-9 w-auto shrink-0 object-contain sm:h-12" />
			<span class="truncate">{SITE_TITLE}</span>
		</a>

		<nav aria-label="Navigation principale" class="col-start-2 hidden justify-self-center md:block">
			<ul class="flex gap-1 text-sm">
				{
					NAV_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? "page" : undefined}
								class:list={[
									"rounded-full px-4 py-2 transition-colors",
									isActive(link.href)
										? "bg-mousse text-sable"
										: "text-brun-600 hover:bg-sable",
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="col-start-3 flex items-center justify-self-end gap-3">
			<ul class="hidden items-center gap-3 md:flex">
				{
					NAVBAR_SOCIAL_LINKS.map((social) => (
						<li>
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={social.label}
								class="block text-black opacity-60 transition-opacity duration-200 ease-in-out hover:opacity-100"
							>
								<svg
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									set:html={socialIconPaths[social.icon]}
								/>
							</a>
						</li>
					))
				}
			</ul>

			<button
				id="nav-toggle"
				type="button"
				class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-brun-600 transition-colors hover:bg-sable md:hidden"
				aria-expanded="false"
				aria-controls="mobile-nav"
				aria-label="Ouvrir le menu"
			>
				<Icon id="nav-icon-open" name="tabler:menu-2" class="h-6 w-6" />
				<Icon id="nav-icon-close" name="tabler:x" class="hidden h-6 w-6" />
			</button>
		</div>
	</div>

	<nav id="mobile-nav" aria-label="Navigation principale (mobile)" class="hidden border-t border-ardoise/30 md:hidden">
		<ul class="flex flex-col gap-1 px-6 py-4 text-sm">
			{
				NAV_LINKS.map((link) => (
					<li>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? "page" : undefined}
							class:list={[
								"block rounded-lg px-4 py-2.5 font-medium transition-colors",
								isActive(link.href)
									? "bg-mousse text-sable"
									: "text-brun-600 hover:bg-sable",
							]}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
		<ul class="flex items-center justify-center gap-3 border-t border-ardoise/30 px-6 py-4">
			{
				NAVBAR_SOCIAL_LINKS.map((social) => (
					<li>
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={social.label}
							class="block text-black opacity-60 transition-opacity duration-200 ease-in-out hover:opacity-100"
						>
							<svg
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								set:html={socialIconPaths[social.icon]}
							/>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById("nav-toggle");
	const mobileNav = document.getElementById("mobile-nav");
	const iconOpen = document.getElementById("nav-icon-open");
	const iconClose = document.getElementById("nav-icon-close");

	toggle?.addEventListener("click", () => {
		const isOpen = mobileNav?.classList.toggle("hidden") === false;
		iconOpen?.classList.toggle("hidden", isOpen);
		iconClose?.classList.toggle("hidden", !isOpen);
		toggle.setAttribute("aria-expanded", String(isOpen));
		toggle.setAttribute("aria-label", isOpen ? "Fermer le menu" : "Ouvrir le menu");
	});
</script>
