---
/**
 * Lightbox.astro — Agrandissement des photos produit au clic
 *
 * USAGE :
 *   import Lightbox from '../components/Lightbox.astro';
 *   <Lightbox />            ← une seule fois par page
 *
 * Puis chaque photo cliquable est un bouton qui enveloppe son image :
 *   <button type="button" class="lightbox-trigger …" data-lightbox="galerie">
 *     <img src="…" alt="…" class="h-full w-full object-cover" />
 *   </button>
 *
 * Les photos qui partagent la même valeur de data-lightbox forment un groupe
 * que l'on parcourt avec les flèches (souris ou clavier ← →).
 *
 * Repose sur <dialog> natif : échappement, piège de focus, retour du focus sur
 * la vignette d'origine et arrière-plan inerte sont gérés par le navigateur.
 */
---

<dialog class="lightbox" aria-label="Photo agrandie">
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Fermer">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>

  <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Photo précédente">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>

  <img class="lightbox__image" src="" alt="" />

  <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Photo suivante">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>

  <p class="lightbox__caption" data-lightbox-caption aria-hidden="true"></p>
  <p class="lightbox__counter" data-lightbox-counter></p>
</dialog>

<style is:global>
  /* ── Vignettes cliquables ──────────────────────────────────── */
  .lightbox-trigger {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .lightbox-trigger img {
    transition: transform 0.35s ease;
  }

  .lightbox-trigger:hover img {
    transform: scale(1.04);
  }

  .lightbox-trigger:focus-visible {
    outline: 2px solid var(--color-rouille-500, #b85438);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-trigger img { transition: none; }
    .lightbox-trigger:hover img { transform: none; }
  }

  /* showModal() rend l'arrière-plan inerte mais le laisse défiler : on fige la
     page tant que la photo est ouverte. Règle sans état, donc rien à restaurer. */
  html:has(.lightbox[open]) {
    overflow: hidden;
  }
</style>

<style>
  /* ── Boîte de dialogue ─────────────────────────────────────── */
  .lightbox {
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: transparent;
    overflow: hidden;
    /* Grille : les flèches encadrent l'image, légende et compteur dessous. */
    display: none;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: minmax(0, 1fr) auto auto;
    align-items: center;
    justify-items: center;
    gap: 0.75rem 1rem;
  }

  .lightbox[open] {
    display: grid;
  }

  .lightbox::backdrop {
    background: rgb(10 22 16 / 0.97);
    backdrop-filter: blur(3px);
  }

  .lightbox__image {
    grid-column: 2;
    grid-row: 1;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.75rem;
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.45);
  }

  .lightbox__caption {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0;
    max-width: 60ch;
    text-align: center;
    font-size: 0.875rem;
    color: #f5ecd8;
  }

  .lightbox__counter {
    grid-column: 1 / -1;
    grid-row: 3;
    margin: 0;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    color: #f5ecd8a8;
  }

  /* ── Boutons ───────────────────────────────────────────────── */
  .lightbox__close,
  .lightbox__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 9999px;
    background: #f5ecd81f;
    color: #f5ecd8;
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: #f5ecd838;
  }

  .lightbox__close:focus-visible,
  .lightbox__nav:focus-visible {
    outline: 2px solid #e8b428;
    outline-offset: 2px;
  }

  .lightbox__close {
    position: absolute;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    height: 2.75rem;
    width: 2.75rem;
  }

  .lightbox__nav {
    grid-row: 1;
    height: 3rem;
    width: 3rem;
  }

  .lightbox__nav--prev { grid-column: 1; }
  .lightbox__nav--next { grid-column: 3; }

  .lightbox svg {
    height: 1.5rem;
    width: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* Sur mobile les flèches passent sous l'image, faute de place sur les côtés. */
  @media (max-width: 640px) {
    .lightbox {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto auto auto;
    }

    .lightbox__image { grid-column: 1; }
    .lightbox__caption,
    .lightbox__counter { grid-column: 1; }
    .lightbox__counter { grid-row: 3; }

    .lightbox__nav {
      grid-row: 4;
      grid-column: 1;
    }

    .lightbox__nav--prev { justify-self: start; }
    .lightbox__nav--next { justify-self: end; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');

  /* Interrogé à chaque ouverture, et non mémorisé au chargement : les photos
     ajoutées ensuite par un script (page Équipements) sont ainsi prises en
     compte. */
  const triggers = () => [...document.querySelectorAll<HTMLElement>('[data-lightbox]')];

  if (dialog) {
    const image = dialog.querySelector<HTMLImageElement>('.lightbox__image')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;
    const close = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;

    let group: HTMLElement[] = [];
    let index = 0;

    const show = (position: number) => {
      index = (position + group.length) % group.length;
      const source = group[index].querySelector('img');
      if (!source) return;

      image.src = source.currentSrc || source.src;
      image.alt = source.alt;
      caption.textContent = source.alt;

      const multiple = group.length > 1;
      counter.textContent = multiple ? `${index + 1} / ${group.length}` : '';
      prev.hidden = !multiple;
      next.hidden = !multiple;
    };

    const open = (trigger: HTMLElement) => {
      const name = trigger.dataset.lightbox;
      group = triggers().filter((item) => item.dataset.lightbox === name);
      show(group.indexOf(trigger));
      dialog.showModal();
    };

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-lightbox]');
      if (trigger) open(trigger);
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    close.addEventListener('click', () => dialog.close());

    /* Clic sur le fond (hors image et boutons) : on ferme. */
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (group.length < 2) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(index - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(index + 1); }
    });
  }
</script>
