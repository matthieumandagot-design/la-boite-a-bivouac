---
import { Icon } from "astro-icon/components";
import { SITE_TITLE, TAGLINE, NAV_LINKS, SOCIAL_LINKS } from "../consts";
import SubscribeForm from "./SubscribeForm.astro";
const year = new Date().getFullYear();
---

<footer class="border-t border-ardoise/30 bg-sable/60">
	<div class="w-full px-6 py-8 text-sm text-brun-600">
		<div class="flex flex-wrap items-start justify-between gap-x-10 gap-y-8">
			<a href="/" class="flex items-center gap-3">
				<img src="/images/logo-badge.png" alt="" aria-hidden="true" class="h-14 w-auto object-contain" />
				<div>
					<p class="font-display text-base font-semibold text-brun-700">{SITE_TITLE}</p>
					<p class="text-xs text-brun-400">{TAGLINE}</p>
					{/* La ville en clair, et pas seulement dans les données
					    structurées : « Occitanie » couvre 13 départements, ce qui
					    ne permet de ressortir sur aucune recherche locale. */}
					<p class="text-xs text-brun-400">Toulouse, Haute-Garonne</p>
				</div>
			</a>

			<div class="max-w-xs">
				<p class="text-sm font-semibold text-brun-700">Restez informé</p>
				<p class="mt-1 text-xs text-brun-400">Recevez nos actus par email.</p>
				<div class="mt-3">
					<SubscribeForm />
				</div>
			</div>

			<nav aria-label="Navigation de pied de page">
				<p class="text-xs font-medium uppercase tracking-widest text-rouille-500">Naviguer</p>
				<ul class="mt-3 grid grid-cols-2 gap-x-10 gap-y-2">
					{
						NAV_LINKS.map((link) => (
							<li>
								<a href={link.href} class="hover:text-rouille-500">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div>
				<p class="text-xs font-medium uppercase tracking-widest text-rouille-500">Suivre</p>
				<ul class="mt-3 flex gap-3" aria-label="Réseaux sociaux">
					{
						SOCIAL_LINKS.map((social) => (
							<li>
								<a
									href={social.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={social.label}
									class="flex h-9 w-9 items-center justify-center rounded-full border border-ardoise/40 text-brun-600 transition-colors hover:border-rouille-400 hover:bg-rouille-500 hover:text-ecru-50"
								>
									<Icon name={social.icon} class="h-5 w-5" />
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<p class="mt-8 border-t border-ardoise/30 pt-5 text-brun-500">
			&copy; {year} {SITE_TITLE} — Conçu et fabriqué en Occitanie.
		</p>
		<p class="mt-2 text-xs text-brun-500/50">
			<a href="/mentions-legales/" class="hover:text-brun-500">Mentions légales</a>
			<span aria-hidden="true"> · </span>
			<a href="/confidentialite/" class="hover:text-brun-500">Politique de confidentialité</a>
		</p>
	</div>
</footer>
