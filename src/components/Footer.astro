---
import { SITE_TITLE } from "../consts";
const year = new Date().getFullYear();
---

<footer class="border-t border-kaki-200 bg-kaki-100/60">
	<div class="mx-auto max-w-5xl px-6 py-10 text-sm text-brun-600">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<p class="font-display text-base font-semibold text-brun-700">{SITE_TITLE}</p>
			<nav aria-label="Navigation de pied de page">
				<ul class="flex flex-wrap gap-x-6 gap-y-2">
					<li><a href="/" class="hover:text-rouille-500">Accueil</a></li>
					<li><a href="/produit" class="hover:text-rouille-500">Le produit</a></li>
					<li><a href="/blog" class="hover:text-rouille-500">Blog</a></li>
					<li><a href="/contact" class="hover:text-rouille-500">Contact</a></li>
				</ul>
			</nav>
		</div>
		<p class="mt-6 text-brun-500">
			&copy; {year} {SITE_TITLE} — Conçu pour les remorques ERDE 193 et les esprits bivouac.
		</p>
	</div>
</footer>
