---
/**
 * Petit SUV gris clair sous le menu principal, avec la remorque grise attelée :
 * la Boîte couleur bois et sa tente de toit noire repliée (dessin revu le
 * 27/09/2026). Elle roule sur le trait bas de l'en-tête et se
 * gare sous la page affichée (demande de Matthieu, 27/09/2026).
 *
 * Le site change de page par un vrai chargement : rien ne survit d'une page à
 * l'autre, sauf ce qu'on garde dans sessionStorage. On y note la dernière page
 * du menu visitée ; à l'arrivée, le convoi part de sous cette entrée et roule
 * jusqu'à la nouvelle. La voiture regarde vers la droite : vers la droite, elle
 * avance ; vers la gauche, elle recule, la remorque en tête.
 *
 * Décoratif uniquement : aria-hidden, aucun clic intercepté, masqué sous md où
 * le menu devient un bouton. Mouvement réduit demandé : le convoi se pose
 * directement à sa place, sans rouler.
 */
---

<div class="convoi" id="convoi-nav" aria-hidden="true">
	<svg viewBox="0 0 84 28" width="84" height="28" focusable="false">
		{/* Remorque grise : la Boîte en bois posée dans la caisse, la tente de
		    toit noire repliée dessus, le garde-boue, le timon et la roue. */}
		<g class="caisse">
			<rect x="7.5" y="2.3" width="21" height="3.9" rx="1.3" class="tente" />
			<line x1="9" y1="3.6" x2="27" y2="3.6" class="tente-reflet" />
			<rect x="6" y="6.2" width="24" height="12.5" rx="0.6" class="boite" />
			<line x1="6.6" y1="9.8" x2="29.4" y2="9.8" class="boite-planche" />
			<line x1="6.6" y1="13.4" x2="29.4" y2="13.4" class="boite-planche" />
			<rect x="4" y="15.6" width="28" height="5.4" rx="0.8" class="remorque" />
			<path d="M13.4 21 A4.6 4.6 0 0 1 22.6 21" class="garde-boue" />
			<line x1="32" y1="19.6" x2="42" y2="20.4" class="timon" />
		</g>
		<g class="roue">
			<circle cx="18" cy="24.6" r="3.4" class="pneu" />
			<circle cx="18" cy="24.6" r="1.3" class="jante" />
			<line x1="18" y1="22" x2="18" y2="27.2" class="rayon" />
		</g>

		{/* Petit SUV gris clair, tourné vers la droite : caisse haute, lunette
		    arrière droite, barres de toit, bas de caisse protégé. */}
		<g class="caisse">
			<line x1="45.5" y1="4.1" x2="63" y2="4.1" class="barres-toit" />
			<line x1="47" y1="4.1" x2="47" y2="5.4" class="barres-pied" />
			<line x1="61.5" y1="4.1" x2="61.5" y2="5.4" class="barres-pied" />
			<path d="M42 21.2 V7 Q42 5.2 43.8 5.2 H65.4 Q66.5 5.2 67.1 6 L71.3 12 H78 Q80.2 12.2 80.2 14.4 V20.2 Q80.2 21.2 79.2 21.2 Z" class="suv" />
			<path d="M44.2 7 H52.2 V11.6 H44.2 Z" class="vitre" />
			<path d="M54 7 H61.4 V11.6 H54 Z" class="vitre" />
			<path d="M63.2 7 H65.6 L68.9 11.6 H63.2 Z" class="vitre" />
			<line x1="53.1" y1="12.3" x2="53.1" y2="18.4" class="portiere" />
			<line x1="62.3" y1="12.3" x2="62.3" y2="18.4" class="portiere" />
			<rect x="42" y="18.6" width="38.2" height="2.6" class="bas-de-caisse" />
			<rect x="78.7" y="13.4" width="1.5" height="1.9" rx="0.4" class="phare" />
			<rect x="42" y="12.4" width="1.1" height="2.4" rx="0.3" class="feu" />
		</g>
		<g class="roue">
			<circle cx="49" cy="24.2" r="3.8" class="pneu" />
			<circle cx="49" cy="24.2" r="1.5" class="jante" />
			<line x1="49" y1="21.2" x2="49" y2="27.2" class="rayon" />
		</g>
		<g class="roue">
			<circle cx="73" cy="24.2" r="3.8" class="pneu" />
			<circle cx="73" cy="24.2" r="1.5" class="jante" />
			<line x1="73" y1="21.2" x2="73" y2="27.2" class="rayon" />
		</g>
	</svg>
</div>

<style>
	.convoi {
		position: absolute;
		left: 0;
		bottom: 0;
		display: none;
		pointer-events: none;
		/* Invisible tant que le script ne l'a pas placé : sans cela, il
		   apparaîtrait un instant contre le bord gauche. */
		visibility: hidden;
		will-change: transform;
	}

	@media (min-width: 768px) {
		.convoi {
			display: block;
		}
	}

	.convoi svg {
		display: block;
		overflow: visible;
	}

	/* Couleurs en dur : les variables du thème Tailwind ne sont émises que si
	   une classe les utilise. Fines bordures sur le gris clair, pour qu'il se
	   détache du fond crème de l'en-tête. */
	.tente {
		fill: #1c1c1c;
	}
	.tente-reflet {
		stroke: #3d3d3d;
		stroke-width: 0.7;
	}
	.boite {
		fill: #c8955a;
		stroke: #9c6b35;
		stroke-width: 0.6;
	}
	.boite-planche {
		stroke: #a8763f;
		stroke-width: 0.55;
	}
	.remorque {
		fill: #8a9196;
	}
	.garde-boue {
		fill: none;
		stroke: #6b7378;
		stroke-width: 1.2;
	}
	.timon {
		stroke: #6b7378;
		stroke-width: 1.3;
		stroke-linecap: round;
	}
	.suv {
		fill: #d5d9dc;
		stroke: #8e969b;
		stroke-width: 0.6;
	}
	.vitre {
		fill: #4b565e;
	}
	.portiere {
		stroke: #a9b0b4;
		stroke-width: 0.5;
	}
	.barres-toit {
		stroke: #7d858a;
		stroke-width: 1;
		stroke-linecap: round;
	}
	.barres-pied {
		stroke: #7d858a;
		stroke-width: 0.8;
	}
	.bas-de-caisse {
		fill: #7d858a;
	}
	.phare {
		fill: #f2d878;
	}
	.feu {
		fill: #b85438;
	}
	.pneu {
		fill: #1e2326;
	}
	.jante {
		fill: #c0c8c8;
	}
	.rayon {
		stroke: #c0c8c8;
		stroke-width: 0.9;
	}

	/* Chaque roue tourne autour de son propre centre. */
	.roue {
		transform-box: fill-box;
		transform-origin: center;
	}

	.convoi.roule .roue {
		animation: rouler 0.45s linear infinite;
	}
	.convoi.recule .roue {
		animation-direction: reverse;
	}
	/* Un léger tangage de la carrosserie pendant le trajet. */
	.convoi.roule .caisse {
		animation: tanguer 0.3s ease-in-out infinite alternate;
	}

	@keyframes rouler {
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes tanguer {
		to {
			transform: translateY(-0.6px);
		}
	}
</style>

<script>
	const CLE = "bab_convoi_page";
	const convoi = document.getElementById("convoi-nav");
	const nav = document.querySelector<HTMLElement>('nav[aria-label="Navigation principale"]');
	const entete = convoi?.parentElement;

	function lienActif(): HTMLAnchorElement | null {
		return nav?.querySelector<HTMLAnchorElement>('a[aria-current="page"]') ?? null;
	}

	/** Abscisse du convoi, dans l'en-tête, pour qu'il soit centré sous le lien. */
	function abscisseSous(lien: HTMLElement): number {
		if (!convoi || !entete) return 0;
		const cadre = entete.getBoundingClientRect();
		const cible = lien.getBoundingClientRect();
		return cible.left + cible.width / 2 - cadre.left - convoi.offsetWidth / 2;
	}

	function lire(): string | null {
		try {
			return sessionStorage.getItem(CLE);
		} catch {
			return null;
		}
	}

	function noter(href: string) {
		try {
			sessionStorage.setItem(CLE, href);
		} catch {
			// Sans stockage, le convoi apparaîtra simplement à sa place.
		}
	}

	function poser(x: number) {
		if (!convoi) return;
		convoi.style.transition = "none";
		convoi.style.transform = `translateX(${x}px)`;
	}

	function demarrer() {
		const actif = lienActif();
		if (!convoi || !actif) return;

		const href = actif.getAttribute("href") ?? "";
		const precedent = lire();
		noter(href);

		const arrivee = abscisseSous(actif);
		const lienDepart =
			precedent && precedent !== href
				? nav?.querySelector<HTMLAnchorElement>(`a[href="${CSS.escape(precedent)}"]`)
				: null;
		const mouvementReduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		if (!lienDepart || mouvementReduit) {
			poser(arrivee);
			convoi.style.visibility = "visible";
			return;
		}

		const depart = abscisseSous(lienDepart);
		poser(depart);
		convoi.style.visibility = "visible";

		// Lecture forcée de la mise en page : sans elle, le navigateur fusionne
		// la pose et le déplacement, et le convoi apparaît déjà arrivé.
		void convoi.offsetWidth;

		const distance = Math.abs(arrivee - depart);
		const duree = Math.min(1400, Math.max(500, 250 + distance * 1.6));
		convoi.classList.add("roule");
		convoi.classList.toggle("recule", arrivee < depart);
		convoi.style.transition = `transform ${duree}ms cubic-bezier(0.45, 0.05, 0.35, 1)`;
		convoi.style.transform = `translateX(${arrivee}px)`;

		convoi.addEventListener(
			"transitionend",
			() => convoi.classList.remove("roule", "recule"),
			{ once: true },
		);
	}

	// Attendre les polices : la largeur des liens du menu en dépend, et un
	// convoi calculé avant se garerait à côté de sa page.
	const pret = document.fonts?.ready ?? Promise.resolve();
	pret.then(demarrer, demarrer);

	// Redimensionnement : le convoi se recale sans rouler.
	window.addEventListener("resize", () => {
		const actif = lienActif();
		if (actif && convoi?.style.visibility === "visible" && !convoi.classList.contains("roule")) {
			poser(abscisseSous(actif));
		}
	});
</script>
