---
/**
 * ScrollReveal.astro — Apparition progressive des éléments au scroll
 *
 * USAGE :
 *   import ScrollReveal from '../components/ScrollReveal.astro';
 *   <ScrollReveal />            ← une seule fois par page
 *
 * Puis sur chaque élément à animer :
 *   <h2 data-reveal>…</h2>                          ← monte depuis le bas
 *   <img data-reveal="left" />                      ← entre par la gauche
 *   <div data-reveal style="--reveal-delay: 120ms"> ← décalage (effet cascade)
 *
 * Accessibilité / robustesse : tout est affiché immédiatement si l'utilisateur
 * a demandé moins d'animations, si JS est désactivé (<noscript>) ou si
 * IntersectionObserver n'existe pas.
 */
---

<style is:global>
  [data-reveal] {
    /* Refonte v2 (11/11/2026) : 400 ms au lieu de 700, 12 px de course,
       décalages ramenés aux deux tiers et plafonnés. Le bloc démarre 100 px
       avant d'entrer à l'écran : plus de zone vide pendant un défilement
       rapide. */
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 400ms var(--ease-out),
      transform 400ms var(--ease-out);
    transition-delay: min(calc(var(--reveal-delay, 0ms) * 0.66), 200ms);
  }

  [data-reveal="left"]  { transform: translateX(-12px); }
  [data-reveal="right"] { transform: translateX(12px); }

  [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Moins de mouvement, pas zéro : on garde un fondu court, sans
       déplacement. */
    [data-reveal] {
      transform: none;
      transition: opacity 200ms ease;
      transition-delay: 0ms;
    }
  }
</style>

<noscript>
  <style>
    [data-reveal] { opacity: 1; transform: none; }
  </style>
</noscript>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reveal = (el: Element) => el.classList.add('is-revealed');

  if (!('IntersectionObserver' in window)) {
    items.forEach(reveal);
  } else {
    /* Une seule apparition : l'élément est libéré dès qu'il est révélé, il ne
       repasse donc pas en fondu si l'on remonte puis redescend. */
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          reveal(entry.target);
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0, rootMargin: '0px 0px 100px 0px' },
    );

    items.forEach((el) => observer.observe(el));
  }
</script>
