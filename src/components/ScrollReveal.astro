---
/**
 * ScrollReveal.astro — Apparition progressive des éléments au scroll
 *
 * USAGE :
 *   import ScrollReveal from '../components/ScrollReveal.astro';
 *   <ScrollReveal />            ← une seule fois par page
 *
 * Puis sur chaque élément à animer :
 *   <h2 data-reveal>…</h2>                          ← monte depuis le bas
 *   <img data-reveal="left" />                      ← entre par la gauche
 *   <div data-reveal style="--reveal-delay: 120ms"> ← décalage (effet cascade)
 *
 * Accessibilité / robustesse : tout est affiché immédiatement si l'utilisateur
 * a demandé moins d'animations, si JS est désactivé (<noscript>) ou si
 * IntersectionObserver n'existe pas.
 */
---

<style is:global>
  [data-reveal] {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  [data-reveal="left"]  { transform: translateX(-1.75rem); }
  [data-reveal="right"] { transform: translateX(1.75rem); }

  [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<noscript>
  <style>
    [data-reveal] { opacity: 1; transform: none; }
  </style>
</noscript>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reveal = (el: Element) => el.classList.add('is-revealed');

  if (
    !('IntersectionObserver' in window) ||
    window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    items.forEach(reveal);
  } else {
    /* Une seule apparition : l'élément est libéré dès qu'il est révélé, il ne
       repasse donc pas en fondu si l'on remonte puis redescend. */
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          reveal(entry.target);
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
    );

    items.forEach((el) => observer.observe(el));
  }
</script>
