<form id="subscribe-form" class="flex w-full max-w-sm flex-col gap-2 sm:flex-row" novalidate>
	<label for="subscribe-email" class="sr-only">Adresse email</label>
	<input
		id="subscribe-email"
		name="email"
		type="email"
		autocomplete="email"
		required
		placeholder="votre@email.fr"
		class="w-full min-w-0 flex-1 rounded-lg border border-ardoise/40 bg-white px-3 py-2 text-sm text-brun-700 focus:border-rouille-400 focus:outline-none focus:ring-2 focus:ring-rouille-400/30"
	/>

	<!-- Honeypot : caché visuellement (hors écran, pas display:none) pour piéger les bots sans gêner les lecteurs d'écran, qui l'ignorent grâce à aria-hidden/tabindex. -->
	<div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
		<label for="subscribe-website">Laissez ce champ vide</label>
		<input id="subscribe-website" name="website" type="text" tabindex="-1" autocomplete="off" />
	</div>

	<button
		type="submit"
		class="shrink-0 rounded-full bg-rouille-500 px-5 py-2 text-sm font-semibold text-ecru-50 shadow-sm transition-colors hover:bg-rouille-400 disabled:cursor-not-allowed disabled:opacity-60"
	>
		M'inscrire
	</button>
</form>
<p id="subscribe-status" role="status" aria-live="polite" class="mt-2 hidden text-xs"></p>

<script>
	const form = document.getElementById("subscribe-form") as HTMLFormElement | null;
	const status = document.getElementById("subscribe-status");
	const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

	function showStatus(message: string, variant: "success" | "error") {
		if (!status) return;
		status.textContent = message;
		status.classList.remove("hidden", "text-green-700", "text-red-700");
		status.classList.add(variant === "success" ? "text-green-700" : "text-red-700");
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!form || !submitButton) return;

		const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
		const website = (form.elements.namedItem("website") as HTMLInputElement).value;

		submitButton.disabled = true;
		submitButton.textContent = "Inscription…";

		try {
			const response = await fetch("/api/subscribe.php", {
				method: "POST",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify({ email, website }),
			});

			let data: { success?: boolean; error?: string } = {};
			try {
				data = await response.json();
			} catch {
				// réponse non-JSON, on retombe sur le statut HTTP
			}

			if (response.ok && data.success) {
				showStatus("✓ Inscription confirmée — vous serez alerté dès la prochaine news.", "success");
				form.reset();
			} else {
				showStatus(
					data.error ?? "Une erreur est survenue lors de l'inscription. Merci de réessayer.",
					"error",
				);
			}
		} catch {
			showStatus(
				"Impossible de contacter le serveur. Vérifiez votre connexion et réessayez.",
				"error",
			);
		} finally {
			submitButton.disabled = false;
			submitButton.textContent = "M'inscrire";
		}
	});
</script>
